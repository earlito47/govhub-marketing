+// leadMissing, isOpenSolicitationType and job_push's fillLead, read out of the
+// shipped source rather than copied.
+//
+// All three guard the 10-06 failure. leadMissing is the check on what
+// Instantly will RENDER (the lead's payload), which is what diverged from the
+// assignment row when a wave 1 lead was moved into A2 with none of its
+// variables. fillLead is how push makes a found lead render before it can be
+// sent. isOpenSolicitationType is the signal job's notice-type test, which let
+// presolicitations through as a substring match.
+import { readFileSync } from 'node:fs';
+const SHARED = readFileSync(new URL('../../supabase/functions/_shared/outreach.ts', import.meta.url), 'utf8');
+const PUSH = readFileSync(new URL('../../supabase/functions/outreach-push/index.ts', import.meta.url), 'utf8');
+
+function slice(src, marker, end = '\n}\n') {
+  const i = src.indexOf(marker);
+  if (i === -1) throw new Error(`${marker} not found`);
+  return src.slice(i, src.indexOf(end, i) + end.length);
+}
+const shared = [
+  slice(SHARED, 'export const REQUIRED', '\n};\n'),
+  slice(SHARED, 'export function leadMissing'),
+  slice(SHARED, 'export const OPEN_SOLICITATION_TYPES', ';\n'),
+  slice(SHARED, 'export function isOpenSolicitationType'),
+].join('\n')
+  .replace(/export /g, '')
+  .replace(/: Record<string, string\[\]>/, '')
+  .replace('(angle: string, lead: Record<string, unknown> | null | undefined): string[] {', '(angle, lead) {')
+  .replace('((lead?.payload ?? {}) as Record<string, unknown>)', '(lead?.payload ?? {})')
+  .replace('(type: string | null | undefined): boolean {', '(type) {');
+const fill = slice(PUSH, 'async function fillLead(')
+  .replace(/async function fillLead\([\s\S]*?\): Promise<string\[\]> \{/, 'async function fillLead(leadId, key, angle, custom, payload, existed) {')
+  .replace('const fill: Record<string, unknown> =', 'const fill =');
+
+const calls = [];
+let patchReply = null;
+// apiCall stub: records every request, answers a PATCH with patchReply.
+const apiCall = async (path, key, method, body) => { calls.push({ path, method, body }); return patchReply; };
+const { leadMissing, isOpenSolicitationType, fillLead } =
+  new Function('apiCall', `${shared}\n${fill}\nreturn { leadMissing, isOpenSolicitationType, fillLead };`)(apiCall);
+
+let bad = 0, n = 0;
+const t = (label, got, want) => {
+  n++;
+  if (JSON.stringify(got) !== JSON.stringify(want)) {
+    bad++; console.error(`FAIL  ${label}\n  got:  ${JSON.stringify(got)}\n  want: ${JSON.stringify(want)}`);
+  }
+};
+
+// ---- leadMissing ----------------------------------------------------------
+// The lead as Instantly held it on 10-06: wave 1's payload, moved into A2.
+const wave1Lead = { payload: { firstName: 'Brandon', companyName: 'G.i.d Construction', uei: 'X', segment: 'serial_bidder' } };
+const A2_ALL = ['sol_line', 'sol_short', 'sol_agency_short', 'sol_close_date', 'naics_code', 'fit_line', 'check_line', 'cta_line', 'followup_line'];
+t('moved wave 1 lead is missing every A2 variable', leadMissing('A2', wave1Lead), A2_ALL);
+t('moved wave 1 lead is missing every A1 variable', leadMissing('A1', wave1Lead), ['agency_short', 'contract_end_month']);
+
+const full = {
+  sol_line: 'Housing (W912)', sol_short: 'W912', sol_agency_short: 'Army', sol_close_date: 'Oct 16',
+  naics_code: '236220', fit_line: 'it fits', check_line: 'checked', cta_line: 'want it?', followup_line: 'still?',
+};
+const complete = { payload: { ...wave1Lead.payload, ...full } };
+t('complete A2 lead passes', leadMissing('A2', complete), []);
+t('whitespace counts as blank', leadMissing('A2', { payload: { ...full, sol_close_date: '  ' } }), ['sol_close_date']);
+t('a leaked token counts as blank', leadMissing('A2', { payload: { ...full, fit_line: '{{naics_code}} fits' } }), ['fit_line']);
+t('a non-string counts as blank', leadMissing('A2', { payload: { ...full, naics_code: 236220 } }), ['naics_code']);
+// The 10-03 copy change: sol_short added to steps 2 and 3, leads pushed before
+// it never had it. That is a lead missing exactly one variable.
+const { sol_short: _s, ...beforeSolShort } = full;
+t('lead pushed before sol_short existed', leadMissing('A2', { payload: beforeSolShort }), ['sol_short']);
+// The write shape is not the read shape: a lead with only custom_variables
+// has not been read back, and must not pass.
+t('custom_variables (write shape) is not read', leadMissing('A2', { custom_variables: full }).length, 9);
+t('null lead', leadMissing('A1', null), ['agency_short', 'contract_end_month']);
+t('A5 requires nothing', leadMissing('A5', wave1Lead), []);
+t('unknown angle requires nothing', leadMissing('A9', wave1Lead), []);
+
+// ---- fillLead -------------------------------------------------------------
+const payload = { company_name: 'G.i.d Construction', email: 'x@example.com' };
+calls.length = 0; patchReply = complete;
+t('found lead: written, response renders', await fillLead('L1', 'k', 'A2', full, payload, true), []);
+t('found lead: one PATCH to the lead', calls.map((c) => `${c.method} ${c.path}`), ['PATCH /leads/L1']);
+t('found lead: PATCH carries the variables and company name', calls[0]?.body,
+  { custom_variables: full, company_name: 'G.i.d Construction' });
+
+calls.length = 0; patchReply = wave1Lead;
+t('PATCH did not take: still missing', await fillLead('L1', 'k', 'A2', full, payload, true), A2_ALL);
+
+calls.length = 0; patchReply = {};
+t('PATCH answered with no payload: still missing', (await fillLead('L1', 'k', 'A2', full, payload, true)).length, 9);
+
+calls.length = 0;
+t('created this run: trusted', await fillLead('L2', 'k', 'A2', full, payload, false), []);
+t('created this run: no API call', calls.length, 0);
+
+// A found A5 lead has nothing to gate but still gets the safe company name,
+// which is what the deployed confirm pass did for every moved lead.
+calls.length = 0; patchReply = wave1Lead;
+t('found A5 lead: renders', await fillLead('L3', 'k', 'A5', {}, payload, true), []);
+t('found A5 lead: still written', calls.map((c) => c.method), ['PATCH']);
+
+// ---- isOpenSolicitationType -----------------------------------------------
+// Every Type label in the live extract (sampled 2026-10-16), and what A2 may name.
+const TYPES = [
+  ['Solicitation', true],
+  ['Combined Synopsis/Solicitation', true],
+  ['Presolicitation', false],                 // the one the substring test let through
+  ['Sources Sought', false],
+  ['Special Notice', false],
+  ['Award Notice', false],
+  ['Justification', false],
+  ['Sale of Surplus Property', false],
+  ['Consolidate/(Substantially) Bundle', false],
+  ['Intent to Bundle Requirements (DoD-Funded)', false],
+  [' Solicitation ', true],                   // stray whitespace in the CSV
+  ['', false],
+  [null, false],
+  [undefined, false],
+];
+for (const [type, want] of TYPES) t(`type ${JSON.stringify(type)}`, isOpenSolicitationType(type), want);
+
+console.log(`${n - bad}/${n} passed`);
+process.exit(bad ? 1 : 0);
