+/** Write this assignment's variables onto a lead POST /leads did not write.
+ * Returns what is still missing; empty means it will render.
+ *
+ * A lead that `existed` before this run is exactly the one skip_if_in_workspace
+ * handed back untouched, so it is always written -- even when it already holds
+ * every variable, because they may be ANOTHER assignment's (a retried row whose
+ * lead survived would otherwise name the old solicitation). The PATCH RESPONSE
+ * is what is checked: it echoes the merged payload at once, while a re-read can
+ * lag and look like a write that failed (govhub-marketing
+ * wave1-display-names.mjs). A lead this run created is trusted: its variables
+ * were in the create body. */
+async function fillLead(
+  leadId: string, key: string, angle: string,
+  custom: Record<string, unknown>, payload: Record<string, unknown>,
+  existed: boolean,
+): Promise<string[]> {
+  if (!existed) return [];
+  // custom_variables MERGES on PATCH, so a moved lead keeps its wave 1 keys.
+  const fill: Record<string, unknown> = { custom_variables: custom };
+  if (payload.company_name) fill.company_name = payload.company_name;
+  const patched = await apiCall(`/leads/${leadId}`, key, "PATCH", fill);
+  return leadMissing(angle, patched);
+}
+
+/** A lead that is in a live campaign and will not render comes out, and its
+ * row goes to failed, which job_assign retries. */
+async function dropBlankLead(
+  sb: ReturnType<typeof db>, a: Record<string, unknown>, leadId: string, key: string,
+  angle: string, email: string, missing: string[],
+): Promise<void> {
+  await apiCall(`/leads/${leadId}`, key, "DELETE");
+  await sb.from("assignments").update({ status: "failed" }).eq("id", a.id);
+  log("push", "lead would have rendered blank and was removed", { email, angle, missing });
+}
