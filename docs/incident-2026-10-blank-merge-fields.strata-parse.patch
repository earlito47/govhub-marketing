+/** The required variables a lead AS INSTANTLY HOLDS IT is missing.
+ *
+ * gate() checks what we meant to send. This checks what Instantly will render,
+ * which is the lead's own payload, and the two diverge whenever POST /leads
+ * finds a lead that already exists: skip_if_in_workspace skips the write, so
+ * the lead keeps whatever it held before. On 10-06 that was a wave 1 payload,
+ * moved into A2, and step 1 sent "Hi Brandon,  posted  and . It closes . ."
+ * while every gate on the assignment row was green.
+ *
+ * Reads `payload`, the READ shape. A fetched lead has no `custom_variables`
+ * (see scripts/outreach-tests/verify-live-leads.mjs), so checking that key
+ * would report every lead as empty. */
+export function leadMissing(angle: string, lead: Record<string, unknown> | null | undefined): string[] {
+  const p = ((lead?.payload ?? {}) as Record<string, unknown>);
+  return (REQUIRED[angle] ?? []).filter((k) => {
+    const v = p[k];
+    return typeof v !== "string" || v.trim() === "" || /\{\{|\}\}/.test(v);
+  });
+}
+
+/** Notice types A2 may name: SAM codes o (Solicitation) and k (Combined
+ * Synopsis/Solicitation). Everything else has nothing to bid on yet, or no
+ * longer has.
+ *
+ * AN EXACT MATCH, NOT A SUBSTRING. The extract's Type column carries labels,
+ * and the test here was `.includes("solicitation")`, which "Presolicitation"
+ * passes. A2's copy says the agency "posted" it, that "it closes" on the
+ * response date and that there are disqualifiers "in this one": three claims a
+ * presolicitation cannot back, because there is no solicitation document yet.
+ * On 10-16, 48 of the 487 notices A2 had ever assigned were presolicitations,
+ * behind 146 leads already emailed.
+ *
+ * Type is the CURRENT type: a presolicitation since posted as a solicitation
+ * reads "Solicitation" here while BaseType keeps "Presolicitation", so this
+ * keys on Type. */
+export const OPEN_SOLICITATION_TYPES = new Set(["Solicitation", "Combined Synopsis/Solicitation"]);
+export function isOpenSolicitationType(type: string | null | undefined): boolean {
+  return OPEN_SOLICITATION_TYPES.has((type ?? "").trim());
+}
