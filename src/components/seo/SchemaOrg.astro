---
/**
 * Emits JSON-LD schema.org markup.
 *
 * Supported `type` values:
 *   - Organization       (default site-wide identity block)
 *   - SoftwareApplication
 *   - Article
 *   - FAQPage
 *   - BreadcrumbList
 *
 * Pass `data` for type-specific fields; sensible defaults are used for
 * Organization when no data is provided.
 */

type SchemaType =
  | 'Organization'
  | 'WebSite'
  | 'SoftwareApplication'
  | 'Article'
  | 'FAQPage'
  | 'BreadcrumbList';

import { SOCIAL_LINKS } from '../../config';

interface Props {
  type: SchemaType;
  data?: Record<string, unknown>;
}

const { type, data = {} } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.govhub.online';

const defaultsByType: Record<SchemaType, Record<string, unknown>> = {
  Organization: {
    '@id': `${siteUrl}/#organization`,
    name: 'GovHub',
    // Brand-variant queries ("gov hub", "gob hub") should resolve to this entity.
    alternateName: ['Gov Hub', 'GovHub.online'],
    url: siteUrl,
    logo: `${siteUrl}/brand/logos/govhub-app-icon-512.png`,
    description: 'GovHub is an AI proposal writing platform for government contractors.',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'hello@govhub.online',
      url: `${siteUrl}/contact/`,
    },
    sameAs: SOCIAL_LINKS.map((s) => s.href),
  },
  // Binds the domain to the organization so GovHub owns its own brand/domain
  // SERP. No SearchAction: the site has no on-site search endpoint to point at.
  WebSite: {
    '@id': `${siteUrl}/#website`,
    name: 'GovHub',
    alternateName: 'Gov Hub',
    url: siteUrl,
    publisher: { '@id': `${siteUrl}/#organization` },
  },
  SoftwareApplication: {
    name: 'GovHub',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    // `price` is required for Offer to validate in Google's Rich Results
    // Test; pages with real pricing (index, pricing) override this whole
    // `offers` block with an AggregateOffer.
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  Article: {},
  FAQPage: { mainEntity: [] },
  BreadcrumbList: { itemListElement: [] },
};

const schema = {
  '@context': 'https://schema.org',
  '@type': type,
  ...defaultsByType[type],
  ...data,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
