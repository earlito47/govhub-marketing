---
/**
 * A list of open bids for a place, a category, or a category in a place.
 * Answer first: how many are open, from how many agencies, and the next
 * deadline, then the list itself, then the links that tie hubs together.
 */
import BidsLayout from './BidsLayout.astro';
import BidList from './BidList.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import CTABand from '../CTABand.astro';
import Pager from './Pager.astro';
import type { BidIndex, Hub } from '../../lib/bids/load';
import { DLA_SEGMENT, FEDERAL_SEGMENT, HUB_PAGE_SIZE, INSIGHTS_STATE_SLUGS, PLACE_BY_SLUG, categoryName, categoryPhrase, formatMonthDay, formatMonthYear, formatShortDate, hubOverflowPages, listLastmod, newlyPosted, placeName } from '../../lib/bids/load';
import { CATEGORIES } from '../../lib/bids/categories';
import { CALENDLY_URL, ctaHref } from '../../config';

interface Props {
  index: BidIndex;
  hub: Hub;
  /** A state slug or "federal". */
  place?: string;
  category?: string;
}

const { index, hub, place, category } = Astro.props;
const MAX_ROWS = HUB_PAGE_SIZE;
// A place hub (not a category or category-in-place hub) continues on
// /bids/{place}/page/{n}/ so every bid in the place has a link from a hub.
const overflow = place && !category ? hubOverflowPages(hub) : [];

const placeLabel = place ? placeName(place) : null;
const catLabel = category ? categoryName(category) : null;
const what = category ? `${categoryPhrase(category)} bids` : place === FEDERAL_SEGMENT ? 'federal bids' : 'government bids';
const where = placeLabel && place !== FEDERAL_SEGMENT ? ` in ${placeLabel}` : '';

const h1 = catLabel
  ? `${catLabel} bids${where}`
  : place === FEDERAL_SEGMENT
    ? 'Federal government bids with no listed location'
    : `Government bids in ${placeLabel}`;
const open = hub.open;
const n = open.length.toLocaleString('en-US');
const month = formatMonthYear(index.builtAt);

// The sitemap's <lastmod>: the newest posting or closing among the bids listed.
const lastmod = listLastmod([...open, ...hub.recentlyClosed], index.builtAt);
// "Newly posted" (place hubs): the list is soonest-deadline first, so a bid
// posted today with a deadline next month sat at the bottom or on page 2.
// Listing the newest here gives it a link from a page Google crawls often.
const freshList = place && !category ? newlyPosted(open, index.builtAt, 10) : [];

// "At a glance": facts computed from this hub's own bids, so every hub says
// something no other page does. List pages ranked on page 1 for rare searches
// but on page 2 or lower for the broad ones ("snow removal bids" 12 to 24,
// "government it bids" 70; Search Console, Oct 31 to Nov 9).
const DAY = 86_400_000;
const nowT = index.builtAt.getTime();
const dueSoon = open.filter((b) => b.dueAt && Date.parse(b.dueAt) - nowT <= 14 * DAY).length;
const postedWeek = open.filter((b) => {
  const t = b.postedAt ? Date.parse(b.postedAt) : NaN;
  return Number.isFinite(t) && t <= nowT && nowT - t <= 7 * DAY;
}).length;
const setAsideOpen = open.filter((b) => b.setAside && !/^(no set.?aside|not set aside|none)/i.test(b.setAside)).length;
const leads = open
  .map((b) => (b.postedAt && b.dueAt ? (Date.parse(b.dueAt) - Date.parse(b.postedAt)) / DAY : NaN))
  .filter((x) => Number.isFinite(x) && x >= 0)
  .sort((a, b) => a - b);
const medianLead = leads.length >= 5 ? Math.round(leads[Math.floor(leads.length / 2)]) : null;
const topPlaces = category && !place
  ? [...open.reduce((m, b) => m.set(b.stateName ?? 'Federal', (m.get(b.stateName ?? 'Federal') ?? 0) + 1), new Map<string, number>())]
      .sort((a, b) => b[1] - a[1]).slice(0, 3)
  : [];
const glance = [
  `${dueSoon.toLocaleString('en-US')} due in the next 14 days`,
  `${postedWeek.toLocaleString('en-US')} posted in the last 7 days`,
  // A count, not a share: state and local notices rarely record a set-aside at
  // all, so "1% set aside" (Massachusetts) would read as fact when it is a gap.
  setAsideOpen > 0 ? `${setAsideOpen.toLocaleString('en-US')} set aside for small or disadvantaged businesses` : null,
  medianLead !== null ? `Typically ${medianLead} days from posting to the deadline` : null,
  topPlaces.length > 1 ? `Most from ${topPlaces.map(([p, c]) => `${p} (${c})`).join(', ')}` : null,
].filter((x): x is string => !!x);

// <title>: the live count and the month, the longest form that fits 60
// characters (check-meta.mjs warns past 60, fails past 70). Hubs ranked on
// page 1 with almost no clicks under a generic title (Search Console, Nov 1 to
// 5: /bids/new-york/ 192 impressions at 6.6, 0 clicks); a number and a date
// say the list is current.
const titleCase = (s: string) => s.replace(/\b([a-z])([a-z]*)/g, (w, a, rest) => (/^(and|in|of|the)$/.test(w) ? w : a.toUpperCase() + rest));
const cat = catLabel ? titleCase(catLabel) : null;
// Long category and place names ("Electronic and Electrical Equipment",
// "District of Columbia") fall back to the two-letter state code.
const code = place && place !== FEDERAL_SEGMENT ? PLACE_BY_SLUG.get(place)?.code : null;
const titles = cat
  ? [
      `${n} Open ${cat} Bids${where} (${month})`,
      `${n} ${cat} Bids${where} (${month})`,
      `${cat} Bids${where} (${month})`,
      ...(code ? [`${n} ${cat} Bids, ${code} (${month})`, `${cat} Bids, ${code} (${month})`] : []),
    ]
  : place === FEDERAL_SEGMENT
    ? [`${n} Open Federal Bids, No Location Listed (${month})`, `${n} Federal Bids, No Location Listed (${month})`]
    : [`${n} Open Government Bids in ${placeLabel} (${month})`, `${n} Government Bids in ${placeLabel} (${month})`, `${placeLabel} Government Bids (${month})`];
const title = titles.find((t) => t.length <= 60) ?? [...titles].sort((a, b) => a.length - b.length)[0];

const agencies = new Map<string, number>();
for (const b of open) {
  const a = b.agency ?? b.sourceName;
  agencies.set(a, (agencies.get(a) ?? 0) + 1);
}
const topAgencies = [...agencies].sort((a, b) => b[1] - a[1]).slice(0, 5);
const next = open.find((b) => b.dueAt);
const checked = formatShortDate(index.builtAt.toISOString());

// Searchers call these tenders as often as bids ("healthcare tenders",
// "grounds maintenance tenders" in Search Console), so the copy names RFPs,
// RFQs, solicitations and tenders once, in plain words.
const lede =
  `${n} open ${what}${where} from ${agencies.size.toLocaleString('en-US')} ` +
  `${agencies.size === 1 ? 'agency' : 'agencies'}: requests for proposals (RFPs), requests for quotes (RFQs) and other solicitations, also called tenders. Checked ${checked}.` +
  (next?.dueAt ? ` The next deadline is ${formatShortDate(next.dueAt, next.timeZone)}: ${next.title}.` : '');

// Meta description from live data: the count, then two or three bids closing
// soon with their dates. 158 characters measured the way check-meta does
// (an & counts as five).
const metaLen = (s: string) => s.replace(/&/g, '&amp;').length;
const clipTo = (s: string, max: number) => (s.length > max ? `${s.slice(0, max - 1).replace(/\s+\S*$/, '')}…` : s);
// Name bids worth a click: due at least two days after the build (the snippet
// outlives the day), not corrections, intents to sole-source or RFIs, and with
// names short enough that two or three fit.
const soonest = Date.parse(index.builtAt.toISOString()) + 2 * 86_400_000;
const NOT_A_BID = /^(correction|amendment|cancel|intent|notice of intent|sources? sought|rfi\b|request for information|special notice)/i;
const nameable = open.filter((b) => b.dueAt && Date.parse(b.dueAt) >= soonest && !NOT_A_BID.test(b.title));
const pick = [...nameable.filter((b) => b.title.length <= 40), ...nameable.filter((b) => b.title.length > 40)].slice(0, 3)
  .sort((a, b) => Date.parse(a.dueAt!) - Date.parse(b.dueAt!));
const soon = pick.map((b) => `${clipTo(b.title, 40)} (${formatMonthDay(b.dueAt!, b.timeZone)})`);
const head = `${n} open ${what}${where}: RFPs, RFQs and tenders.`;
let description = head;
for (let k = soon.length; k > 0; k--) {
  const d = `${head} Closing soon: ${soon.slice(0, k).join('; ')}.`;
  if (metaLen(d) <= 158) { description = d; break; }
}
if (description === head) description = `${head} From ${agencies.size.toLocaleString('en-US')} ${agencies.size === 1 ? 'agency' : 'agencies'}, updated ${checked}.`;

// Cross-links. A place hub lists its categories; a category hub lists its
// places; a category-in-place hub lists both directions.
const categoryLinks = place && place !== FEDERAL_SEGMENT
  ? CATEGORIES.filter((c) => c.slug !== category && index.categoryStateHubs.has(`${c.slug}/${place}`)).map((c) => ({
      href: `/bids/${c.slug}/${place}/`,
      label: c.name,
      count: index.categoryStateHubs.get(`${c.slug}/${place}`)!.open.length,
    }))
  : [];
const placeLinks = category
  ? [...index.categoryStateHubs]
      .filter(([k]) => k.startsWith(`${category}/`) && k !== `${category}/${place}`)
      .map(([k, h]) => ({ href: h.path, label: placeName(k.split('/')[1]), count: h.open.length }))
      .sort((a, b) => b.count - a.count)
  : [];

// DLA parts buys have no page each; they are all on /bids/dla-parts/. Point to
// it from the federal hub and from any category those buys fall in.
const dlaHere = !place || place === FEDERAL_SEGMENT
  ? index.dlaParts.filter((b) => (category ? b.categories.includes(category) : true)).length
  : 0;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Bids', url: '/bids/' },
  ...(category && place ? [{ name: categoryName(category), url: `/bids/${category}/` }] : []),
  { name: h1, url: hub.path },
];
---

<BidsLayout title={title} description={description} lastmod={lastmod}>
  <Breadcrumbs items={crumbs} />
  <p class="eyebrow">Open government bids</p>
  <h1>{h1}</h1>
  <p class="lede">{lede}</p>
  {glance.length > 0 && (
    <ul class="glance" aria-label="At a glance">
      {glance.map((g) => <li>{g}</li>)}
    </ul>
  )}
  {dlaHere > 0 && (
    <p class="dla-note">
      Defense Logistics Agency spare-parts buys are listed together on one page:{' '}
      <a href={`/bids/${DLA_SEGMENT}/`}>{dlaHere.toLocaleString('en-US')} open DLA parts solicitations</a>, with NSNs and
      solicitation numbers.
    </p>
  )}

  <BidList
    bids={open.slice(0, MAX_ROWS)}
    caption={open.length > MAX_ROWS ? `The ${MAX_ROWS} soonest deadlines of ${open.length.toLocaleString('en-US')} open bids` : `${open.length} open bids, soonest deadline first`}
    showPlace={!place || place === FEDERAL_SEGMENT}
  />

  {overflow.length > 0 && (
    <Pager base={hub.path} current={1} total={overflow.length + 1} label={placeLabel!} />
  )}

  {freshList.length > 0 && (
    <>
      <h2>Newly posted</h2>
      <BidList bids={freshList} caption="The newest open bids by the date the agency posted them, newest first" showPlace={!place || place === FEDERAL_SEGMENT} />
    </>
  )}

  {topAgencies.length > 1 && (
    <>
      <h2>Agencies with the most open {what}{where}</h2>
      <ul class="agency-list">
        {topAgencies.map(([name, n]) => (
          <li>{name} <span class="muted">({n})</span></li>
        ))}
      </ul>
    </>
  )}

  {categoryLinks.length > 0 && (
    <>
      <h2>{category ? `Other bids in ${placeLabel}` : `Bids in ${placeLabel} by category`}</h2>
      <ul class="chip-list">
        {categoryLinks.map((l) => (
          <li><a href={l.href}>{l.label}<span class="count">{l.count}</span></a></li>
        ))}
      </ul>
    </>
  )}

  {placeLinks.length > 0 && (
    <>
      <h2>{catLabel} bids in other states</h2>
      <ul class="chip-list">
        {placeLinks.map((l) => (
          <li><a href={l.href}>{l.label}<span class="count">{l.count}</span></a></li>
        ))}
      </ul>
    </>
  )}

  {category && place && (
    <p><a href={`/bids/${place}/`}>All government bids in {placeLabel}</a> · <a href={`/bids/${category}/`}>{catLabel} bids nationwide</a></p>
  )}
  {place && INSIGHTS_STATE_SLUGS.has(place) && (
    <p class="muted">Looking for past awards? See <a href={`/insights/state/${place}/`}>federal contract spending in {placeLabel}</a>.</p>
  )}

  {hub.recentlyClosed.length > 0 && (
    <>
      <h2>Recently closed</h2>
      <BidList bids={hub.recentlyClosed} caption="Closed in the last 90 days, most recent first" showPlace={!place || place === FEDERAL_SEGMENT} />
    </>
  )}

  <CTABand
    heading={`See new ${what}${where} in one inbox`}
    sub="Save this search in GovHub and new matches land in your GovHub inbox, with a plain-English summary and the deadline. When one fits, GovHub fills out the forms and drafts the proposal."
    primaryHref={`${ctaHref('bids_hub')}&next=${encodeURIComponent('/v2/opportunities')}`}
    secondaryHref={CALENDLY_URL}
    secondaryLabel="Book a demo"
  />

  <p class="updated-line">
    Federal bids from SAM.gov; state and local bids from {index.sourceCount.toLocaleString('en-US')} official sources. Updated
    {checked}. Summaries are written by GovHub from each notice; confirm details on the official notice.
  </p>
</BidsLayout>

<style>
  .glance {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    max-width: 52rem;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .glance li::before {
    content: '•';
    margin-right: 0.4rem;
    color: var(--gh-teal-600);
  }
  .dla-note {
    border-left: 3px solid var(--border);
    padding: 0.5rem 0.9rem;
    margin: 0.75rem 0 0;
    max-width: 46rem;
    color: var(--fg-muted);
  }
  .agency-list {
    columns: 2 18rem;
    padding-left: 1.1rem;
  }
  .agency-list li {
    margin-bottom: 0.3rem;
    break-inside: avoid;
  }
</style>
