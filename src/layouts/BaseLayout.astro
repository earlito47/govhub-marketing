---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import { CALENDLY_URL } from '../config';
import Analytics from '../components/Analytics.astro';
// Self-hosted Gold Country type (no render-blocking Google Fonts request).
// Fraunces needs full.css for the SOFT/WONK axes the brand guide pins.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** og:type — pass 'article' from blog/case-study detail layouts. */
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = 'GovHub: AI proposal writing for government contractors. Draft, review, and submit federal, state, and local RFP responses faster.',
  canonical,
  ogImage = '/brand/social/og-default-1200x630.png',
  ogImageAlt = 'GovHub: AI proposal software for government contractors',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const fullOgImage = new URL(ogImage, Astro.site).toString();

// GA4 measurement ID. Hardcoded on purpose: it is a public identifier that ships
// in plaintext to every visitor, and app.govhub.online already carries this same
// one in index.html. It used to come only from PUBLIC_GA_MEASUREMENT_ID, but this
// Pages project has a wrangler.jsonc, which makes the Wrangler file the source of
// truth and stops Cloudflare passing dashboard plain-text variables into the build
// ("Build environment variables: (none found)" in the build log). The variable was
// set correctly in the dashboard and still never reached `astro build`, so the
// guard below rendered nothing and www shipped with no analytics at all. An
// explicit env var still wins if one is ever provided.
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? 'G-CBS7SWVWVJ';

// Meta (Facebook) Pixel ID. Hardcoded with an env override for exactly the same
// reason as GA4 above: this project's wrangler.jsonc stops Cloudflare passing
// dashboard plain-text variables into `astro build`, so a bare env var would
// resolve to undefined and ship a page with no pixel — silently, which is the
// failure this file already carries 64 days of scar tissue about. A pixel ID is
// a public identifier; every site running one serves it in plaintext.
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID ?? '1782130059453495';

// LinkedIn Insight Tag partner ID. Same hardcode-with-override rule as the two
// IDs above, for the same wrangler.jsonc reason. Also a public identifier.
//
// This was going to live in Cloudflare Zaraz — one install for both hosts, no
// code. Zaraz accepted the tool and its triggers evaluated correctly, but the
// tool emitted nothing: Cloudflare does not validate the `component` field, and
// every identifier tried was accepted while producing an empty action. A tool
// that looks installed and collects zero is worse than no tool, so the zone was
// rolled back to its previous state and the tag ships here instead.
const LINKEDIN_PARTNER_ID = import.meta.env.PUBLIC_LINKEDIN_PARTNER_ID ?? '9674602';

// Deliberately fails OPEN: analytics ships unless we positively identify a
// non-production context. `astro dev` is excluded by PROD, and a Cloudflare
// preview branch by name, which is what the old env-var gate achieved. If
// CF_PAGES_BRANCH is ever renamed or missing the tag still ships — a silently
// absent variable is precisely what took www off analytics before.
const GA_BRANCH = process.env.CF_PAGES_BRANCH;
// One gate for GA4 and PostHog. Renamed from GA_ENABLED because PostHog now
// rides the same rule: two analytics products with two enable predicates is how
// they drift out of sync.
//
// This gate is kept, not bypassed. The 64-day outage was caused by
// PUBLIC_GA_MEASUREMENT_ID resolving to undefined (the value never reached the
// build), NOT by this predicate, which already fails OPEN. Bypassing it would
// pollute the live GA4 property and the live PostHog project from every preview
// branch. It cannot cover a production-branch deploy served from its *.pages.dev
// alias, so Analytics.astro adds a runtime hostname denylist too.
const ANALYTICS_ENABLED =
  import.meta.env.PROD && (GA_BRANCH === undefined || GA_BRANCH === 'main');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="GovHub" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <link rel="icon" type="image/svg+xml" href="/brand/logos/govhub-favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/logos/govhub-app-icon-512.png" />
    <meta name="theme-color" content="#faf5ec" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="stylesheet" href="/brand/tokens/tokens.css" />

    <SchemaOrg type="Organization" />
    <SchemaOrg type="WebSite" />

    {/* Cloudflare Web Analytics — renders nothing until PUBLIC_CF_BEACON_TOKEN
        is set (Cloudflare Pages → Settings → Environment variables; token from
        CF dashboard → Web Analytics → add site). Measures the trial CTAs. */}
    {import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: import.meta.env.PUBLIC_CF_BEACON_TOKEN })}
      />
    )}

    {/* GA4 — measurement ID and the on/off rule live in the frontmatter above.
        Runs alongside Cloudflare Web Analytics — GA4 and CF Analytics measure
        independently, keep both. */}
    {ANALYTICS_ENABLED && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
        />
        <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    {/* Meta Pixel. Same ANALYTICS_ENABLED gate as GA4, PLUS a runtime hostname
        denylist identical to the one in Analytics.astro. The build-time gate is
        not sufficient on its own: a production-branch deploy is also served from
        <hash>.govhub-marketing.pages.dev with byte-identical HTML and
        CF_PAGES_BRANCH set to 'main', so without the runtime check preview
        traffic would land in the pixel's audiences — and a Meta custom audience,
        like a GA4 property, has no retroactive cleanup.

        Unlike the app (app.govhub.online), www is a static multi-page site: a
        full document load per navigation, so the stock snippet's single
        fbq('track','PageView') per load is exactly right here and there is no
        SPA route-change hook to add. */}
    {ANALYTICS_ENABLED && (
      <>
        <script is:inline define:vars={{ metaPixelId: META_PIXEL_ID }}>
          var META_DEV_HOST =
            /^localhost$|^127\.|^\[?::1\]?$|\.local$|\.pages\.dev$|\.workers\.dev$|\.lovable\.app$/;
          if (!META_DEV_HOST.test(location.hostname)) {
            !function(f,b,e,v,n,t,s)
            {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window, document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', metaPixelId);
            fbq('track', 'PageView');
          }
        </script>
        {/* Meta's no-JS fallback. It cannot carry the hostname guard above —
            that is what "no JS" means — so on the main-branch *.pages.dev alias
            a visitor with JavaScript disabled would still register. That is a
            rounding error on a set that is already nearly empty, and dropping
            the tag would mean silently under-counting real no-JS visitors on
            www, which is the worse trade. */}
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            alt=""
            src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
          />
        </noscript>
      </>
    )}

    {/* LinkedIn Insight Tag. Same gate and same runtime hostname denylist as the
        Meta pixel above — a LinkedIn website audience has no retroactive cleanup
        either, and the build-time gate cannot see the main-branch *.pages.dev
        alias.

        Coverage is deliberately identical to Meta's: BaseLayout does not wrap
        src/pages/embed/[chartId].astro, so the 900 noindex chart iframes that
        render inside third-party pages carry no ad tags. That exclusion is the
        main reason this is in code rather than at the edge — Zaraz injects on
        every hostname in the zone, embeds included, and would have recorded an
        audience member for every impression on somebody else's site. */}
    {ANALYTICS_ENABLED && (
      <>
        <script is:inline define:vars={{ liPartnerId: LINKEDIN_PARTNER_ID }}>
          var LI_DEV_HOST =
            /^localhost$|^127\.|^\[?::1\]?$|\.local$|\.pages\.dev$|\.workers\.dev$|\.lovable\.app$/;
          if (!LI_DEV_HOST.test(location.hostname)) {
            window._linkedin_partner_id = liPartnerId;
            window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
            window._linkedin_data_partner_ids.push(liPartnerId);
            (function (l) {
              if (!l) {
                window.lintrk = function (a, b) { window.lintrk.q.push([a, b]); };
                window.lintrk.q = [];
              }
              var s = document.getElementsByTagName('script')[0];
              var b = document.createElement('script');
              b.type = 'text/javascript';
              b.async = true;
              b.src = 'https://snap.licdn.com/li.lms-analytics/insight.min.js';
              s.parentNode.insertBefore(b, s);
            })(window.lintrk);
          }
        </script>
        {/* Same no-JS caveat as Meta's: this cannot carry the hostname guard,
            so a JavaScript-disabled visitor on the main-branch pages.dev alias
            still registers. Same rounding error, same trade. */}
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            alt=""
            src={`https://px.ads.linkedin.com/collect/?pid=${LINKEDIN_PARTNER_ID}&fmt=gif`}
          />
        </noscript>
      </>
    )}

    {/* Attribution + PostHog + landing_view. Placed AFTER the GA4 block on
        purpose: the gtag() shim above is defined synchronously, so window.gtag
        exists by the time this runs and the event reaches both destinations.
        Rendered unconditionally, gated by the prop: the first-touch cookie and
        the CTA link decoration are page behaviour and must work on previews
        too; only the sending is switched off. */}
    <Analytics enabled={ANALYTICS_ENABLED} />

    {/* Calendly "Book a Demo" floating badge — site-wide. addEventListener
        (not window.onload=) so other load handlers keep working; async
        scripts delay the load event, so widget.js is executed by then. The
        Calendly guard covers ad-blockers eating widget.js. */}
    <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
    <script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>
    <script is:inline define:vars={{ calendlyUrl: CALENDLY_URL }}>
      window.addEventListener('load', function () {
        if (window.Calendly) {
          window.Calendly.initBadgeWidget({
            url: calendlyUrl,
            text: 'Book a Demo',
            color: '#A03A2C', /* --gh-maroon-600 */
            textColor: '#ffffff',
            branding: true,
          });
        }
      });
    </script>
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    /* Gold Country palette — legacy var names remapped onto the brand tokens
       (loaded from /brand/tokens/tokens.css) so every scoped style keeps working. */
    --bg: var(--gh-oat);
    --bg-elevated: var(--gh-surface);
    --fg: var(--gh-ink-900);
    --fg-muted: var(--gh-ink-700);
    --accent: var(--gh-maroon-600);
    --accent-hover: var(--gh-maroon-700);
    --accent-soft: rgba(160, 58, 44, 0.08);
    --border: var(--gh-line);
    --shadow: var(--gh-shadow-card);
    --max-width: 72rem;
    --content-width: 42rem;
  }

  * {
    box-sizing: border-box;
  }

  img {
    max-width: 100%;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  body {
    /* Fontsource variable families register with a " Variable" suffix, so
       re-point the token font vars here (body beats :root for inheritance). */
    --gh-font-display: 'Fraunces Variable', Georgia, serif;
    --gh-font-brand: 'Bricolage Grotesque Variable', 'Figtree Variable', sans-serif;
    --gh-font-body: 'Figtree Variable', -apple-system, 'Segoe UI', sans-serif;
    font-family: var(--gh-font-body);
  }

  a {
    color: var(--gh-teal-700);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  h1,
  h2,
  h3 {
    font-family: var(--gh-font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 0;
    font-weight: 600;
    color: var(--gh-ink-900);
    line-height: 1.15;
    letter-spacing: 0;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
  }
  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  main {
    min-height: calc(100vh - 12rem);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .prose {
    max-width: var(--content-width);
  }

  .prose p {
    color: var(--fg-muted);
    font-size: 1.05rem;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.95em;
  }
</style>
