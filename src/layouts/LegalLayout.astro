---
// Shared shell for the legal pages (/terms/, /privacy/, /acceptable-use/,
// /cookies/, /subprocessors/, /legal/). The document text lives in
// src/legal/*.md so counsel can review and edit plain Markdown; this layout
// adds the title, version, effective date and the links between documents.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { COMPANY, LEGAL_DOCS, type LegalDocKey } from '../data/legal';

interface Props {
  doc: LegalDocKey;
}

const { doc } = Astro.props;
const d = LEGAL_DOCS[doc];
const others = (Object.keys(LEGAL_DOCS) as LegalDocKey[]).filter((k) => k !== doc);
---

<BaseLayout title={d.metaTitle} description={d.description}>
  <main class="container">
    <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: d.name, url: d.path }]} />

    <article class="prose legal">
      <h1>{d.name}</h1>
      <div class="gh-divider-ridge" aria-hidden="true"></div>
      <p class="meta">
        {COMPANY.legalName} · Version {d.version} · Effective {d.effective}
      </p>

      <div class="legal-body">
        <slot />
      </div>

      <nav class="legal-nav" aria-label="Legal documents">
        <p class="legal-nav-heading">Other legal documents</p>
        <ul>
          {others.map((k) => (
            <li><a href={LEGAL_DOCS[k].path}>{LEGAL_DOCS[k].name}</a></li>
          ))}
        </ul>
      </nav>
    </article>
  </main>
</BaseLayout>

<style>
  main { padding: 1rem 1.5rem 3rem; }
  .legal { max-width: 46rem; margin: 1rem 0; }
  .meta { color: var(--fg-muted); font-size: 0.9rem; }
  .legal-body :global(h2) { margin-top: 2.25rem; font-size: 1.3rem; }
  .legal-body :global(h3) { margin-top: 1.5rem; font-size: 1.1rem; }
  .legal-body :global(p),
  .legal-body :global(li) { color: var(--fg-muted); }
  .legal-body :global(ul),
  .legal-body :global(ol) { padding-left: 1.25rem; }
  .legal-body :global(li) { margin: 0.4rem 0; }
  .legal-body :global(strong) { color: var(--fg); }
  .legal-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    margin: 1rem 0;
    display: block;
    overflow-x: auto;
  }
  .legal-body :global(th),
  .legal-body :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--border);
    color: var(--fg-muted);
  }
  .legal-body :global(th) { color: var(--fg); font-weight: 600; }
  .legal-nav {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .legal-nav-heading { font-weight: 600; color: var(--fg); margin: 0 0 0.5rem; }
  .legal-nav ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
</style>
