---
// NAICS entity dashboard — one page per file in src/data/insights/naics/.
import type { GetStaticPaths } from 'astro';
import type { InsightsPage } from '../../../lib/insightsTypes';
import InsightsLayout from '../../../components/insights/InsightsLayout.astro';
import EntityDashboard from '../../../components/insights/EntityDashboard.astro';
import { categoryPhrase, getBidIndex } from '../../../lib/bids/load';
import { categorize } from '../../../lib/bids/categories';

export const getStaticPaths = (() => {
  const files = import.meta.glob<{ default: InsightsPage }>('../../../data/insights/naics/*.json', { eager: true });
  return Object.entries(files).map(([path, mod]) => {
    const slug = path.split('/').pop()!.replace('.json', '');
    return { params: { slug }, props: { page: mod.default } };
  });
}) satisfies GetStaticPaths;

interface Props {
  page: InsightsPage;
}

const { page } = Astro.props;
const canonical = new URL(`/insights/naics/${page.slug}/`, Astro.site).toString();
// The bid category this NAICS code files under, when it has a hub.
const bidsCategory = categorize('', [page.slug])[0];
const bidsHub = bidsCategory ? (await getBidIndex()).categoryHubs.get(bidsCategory) : undefined;
const bidsLink = bidsHub
  ? { href: bidsHub.path, label: `See ${bidsHub.open.length.toLocaleString('en-US')} open ${categoryPhrase(bidsCategory)} bids` }
  : undefined;
---

<InsightsLayout
  title={page.title}
  noindex={page.noindex}
  description={page.metaDescription}
  dataset={{
    name: `Federal contract obligations: NAICS ${page.slug}`,
    description: page.metaDescription,
    dateModified: page.updated,
    temporalCoverage: `${page.fyWindow.start}/${page.fyWindow.end}`,
    url: canonical,
  }}
>
  <EntityDashboard
    page={page}
    breadcrumbs={[
      { name: 'Home', url: '/' },
      { name: 'Insights', url: '/insights/' },
      { name: `NAICS ${page.slug}`, url: `/insights/naics/${page.slug}/` },
    ]}
    eyebrow={`Federal contract market · NAICS ${page.slug}`}
    campaign="naics"
    bidsLink={bidsLink}
  />
</InsightsLayout>
