---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQSchema from '../../components/seo/FAQSchema.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SchemaOrg from '../../components/seo/SchemaOrg.astro';
import { competitors, type Competitor } from '../../data/competitors';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import PriceComparison from '../../components/PriceComparison.astro';
import CompareLinks from '../../components/CompareLinks.astro';
import { PLANS, formatUsd } from '../../data/pricing';
import { CALENDLY_URL, ctaHref } from '../../config';
import { asClause } from '../../lib/text';

export function getStaticPaths() {
  return competitors.map((c) => ({
    params: { competitor: c.slug },
    props: { competitor: c },
  }));
}

interface Props {
  competitor: Competitor;
}

const { competitor } = Astro.props;
const isOpportunityIntel = competitor.category === 'opportunity-intelligence';
// Bid services (BidPrime, BidNet Direct, PlanetBids): GovHub now finds bids
// too, so these compare like with like on finding and then show the rest.
const isBidSearch = competitor.category === 'bid-search';

const title = isOpportunityIntel
  ? `GovHub and ${competitor.name}: how they compare`
  : `GovHub vs ${competitor.name}`;
const trialHref = `${ctaHref(`vs_${competitor.slug}`)}${isBidSearch ? `&next=${encodeURIComponent('/v2/opportunities')}` : ''}`;

// <title> uses the compact competitor name and a short qualifier to stay
// within the ~60-char SERP budget; the H1 keeps the full name. Every variant
// carries "vs" and a current-year modifier — the "<x> vs" query pattern is
// this page type's money query (GSC 2026-08: /vs/govwin-iq/ pulled 305
// impressions at position 26 while its title said neither "vs" nor a year).
// The year comes from the build clock; weekly pipeline rebuilds keep it fresh.
const shortName = competitor.shortName ?? competitor.name;
const YEAR = new Date().getFullYear();
const metaTitle = isOpportunityIntel
  ? `GovHub vs ${shortName} (${YEAR}): do you need both?`
  : isBidSearch
    ? `GovHub vs ${shortName} (${YEAR}): bids and the proposal`
    : `GovHub vs ${shortName} (${YEAR}): government proposal software`;

// Same reasoning as the /alternatives/ descriptions: lead with the number.
// GovHub publishing a starting price is the one claim these SERPs cannot
// match, since every competitor here quotes by sales call only.
const startingPrice = `${formatUsd(PLANS[0].monthlyUsd)}/mo`;
const description = isOpportunityIntel
  ? `${shortName} forecasts federal contracts years before the RFP. GovHub finds open bids and writes the response. See what each does, costs and when to run both.`
  : isBidSearch
    ? `${shortName} ${competitor.priceHook}. GovHub finds and matches bids too, then writes the proposal and fills the forms, from ${startingPrice}.`
    : `${shortName} ${competitor.priceHook}, quoted by sales call only. GovHub publishes tiers from ${startingPrice}. Compare both on federal compliance and AI drafting.`;
---

<BaseLayout title={metaTitle} description={description} ogImage="/brand/page-graphics/compare-weigh-options@2x.png">
  <SchemaOrg
    type="SoftwareApplication"
    data={{
      name: 'GovHub',
      description: 'Government contracting software: bid search and matching, proposal writing and scoring, and form filling.',
    }}
  />

  <main class="container">
    <Breadcrumbs
      items={[
        { name: 'Home', url: '/' },
        { name: 'Compare', url: '/vs/' },
        { name: competitor.name, url: `/vs/${competitor.slug}/` },
      ]}
    />

    <PageHero art="/brand/page-graphics/compare-weigh-options.svg">
      <header class="prose">
        <h1>{title}</h1>
      </header>
    </PageHero>

    <article class="prose">

      {isOpportunityIntel ? (
        <p class="lede">
          {competitor.name} is {asClause(competitor.tagline)}.
          GovHub finds open federal, state and local bids, matches them to your
          company and writes the proposal. They overlap less than it looks:
          {' '}{competitor.name}'s edge is <strong>research on contracts years
          before they are posted</strong>; GovHub works from the posted bid to the
          submitted response.
        </p>
      ) : isBidSearch ? (
        <p class="lede">
          {competitor.name} is {asClause(competitor.tagline)}.
          GovHub does that first step too, finding open bids and matching them to
          your company, and then keeps going: it reads the solicitation, writes the
          proposal, scores it and fills out the forms. This page compares the two
          on finding bids, and then on everything after.
        </p>
      ) : (
        <p class="lede">
          {competitor.name} is {asClause(competitor.tagline)}.
          It's best suited for {asClause(competitor.bestFor)}.
          GovHub is a government-specific alternative built around the structural
          conventions of federal, state, and local proposals. This page walks
          through how the two compare on the dimensions that matter for
          government contractors.
        </p>
      )}

      <PriceComparison competitorName={competitor.name} competitorEstimate={competitor.pricingEstimate} pricingCanonical={competitor.pricingCanonical} published={competitor.publishedPricing} />

      {isOpportunityIntel ? (
        <>
          <h2>Do you need both, or one or the other?</h2>
          <p>
            If your problem is <strong>knowing which federal contracts are
            coming</strong> 12–36 months ahead of the RFP, {competitor.name}'s
            analyst research is designed for that. GovHub does not forecast
            contracts before they are posted.
          </p>
          <p>
            If your problem is <strong>finding open bids that fit and winning
            them</strong>, GovHub covers it end to end: federal, state and local
            bids matched to your NAICS codes and set-asides, then the compliance
            matrix, the draft, the score and the forms.
            {' '}{competitor.name} does not do proposal writing or content
            generation.
          </p>
          <p>
            Teams pursuing large federal recompetes years out often use both: a
            capture manager tracks the pipeline in {competitor.name}, and GovHub
            takes each bid from posting to submission.
          </p>
        </>
      ) : isBidSearch ? (
        <>
          <h2>Quick answer: which one should you use?</h2>
          <p>
            If all you need is a list of bids, {competitor.name} and GovHub both
            give you one; compare coverage and price below. If you also have to
            <strong> respond</strong> to those bids, GovHub does the rest of the
            job in the same place: it reads the solicitation, drafts the
            proposal, scores it against the evaluation criteria and fills out the
            forms. {competitor.name} stops at the bid.
          </p>
        </>
      ) : (
        <h2>Quick answer: which one should you use?</h2>
      )}

      {!isOpportunityIntel && !isBidSearch && (
        <p>
          If your team primarily responds to <strong>government solicitations</strong>,
          federal RFPs, state and local RFQs, sources sought, or task orders on IDIQ
          vehicles, GovHub is designed for that workflow end to end. {competitor.name} is
          a strong choice for {asClause(competitor.bestFor)},
          but government-specific requirements (Section L/M structure, FAR/DFARS
          compliance, Section 508 conformance, set-aside representations) are not
          its primary design center.
        </p>
      )}

      <h2>Comparison at a glance</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Dimension</th>
              <th>GovHub</th>
              <th>{competitor.name}</th>
            </tr>
          </thead>
          <tbody>
            {competitor.comparisonPoints.map((p) => (
              <tr>
                <th scope="row">{p.label}</th>
                <td>{p.govhub}</td>
                <td>{p.competitor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>Where {competitor.name} is strong</h2>
      <ul>
        {competitor.strengths.map((s) => <li>{s}</li>)}
      </ul>

      <h2>{isOpportunityIntel ? `Where teams look elsewhere` : isBidSearch ? `Where GovHub goes further` : `Where GovHub wins for government work`}</h2>
      <ul>
        {competitor.weaknesses.map((w) => <li>{w}</li>)}
      </ul>

      {isOpportunityIntel ? (
        <>
          <h2>Can GovHub and {competitor.name} work together?</h2>
          <p>
            Yes. {competitor.name} handles the pre-solicitation research;
            GovHub handles everything from the posted bid on, finding and
            matching it, then the response. The handoff point is the day the
            solicitation is posted.
          </p>
        </>
      ) : isBidSearch ? (
        <>
          <h2>Should you switch from {competitor.name} to GovHub?</h2>
          <p>
            Switching makes sense if you pay {competitor.name} to find bids and
            then write every response by hand or in a second tool. GovHub puts
            both in one subscription. If you only ever need bid notices and
            already have a proposal process you like, {competitor.name} may be
            enough on its own.
          </p>
        </>
      ) : (
        <>
          <h2>Should you switch from {competitor.name} to GovHub?</h2>
          <p>
            Switching makes sense if the majority of your responses are government
            solicitations and you are spending significant time working around
            {competitor.name}'s general-purpose design to fit government-specific
            requirements. If your response mix is mostly commercial B2B RFPs with
            occasional government work, staying on {competitor.name} may be the
            right call.
          </p>
        </>
      )}

      <p class="cta-pair">
        <a class="primary" href={trialHref}>Start free trial</a>
        <a class="secondary" href={CALENDLY_URL} data-demo-cta={`vs_${competitor.slug}`}>Book a demo</a>
      </p>
    </article>

    <CompareLinks competitor={competitor} current="vs" />

    <FAQSchema faqs={competitor.faqs} heading={`${title}: FAQ`} />

    <CTABand
      heading={isBidSearch ? 'Find the bid and write the proposal in one place' : 'Try the government-specific option'}
      sub={isBidSearch ? '14 days free, no card. Matched bids land in your GovHub inbox as soon as your company profile is set up.' : 'Bring your next solicitation, the first draft is ready before the trial ends.'}
      primaryHref={trialHref}
      secondaryHref="/pricing/"
      secondaryLabel="See pricing"
    />
  </main>
</BaseLayout>

<style>
  main {
    padding-bottom: 3rem;
  }
  .prose {
    max-width: 48rem;
    margin: 2rem 0 3rem;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--fg-muted);
    margin-bottom: 2rem;
  }
  .pricing-note {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin: 2rem 0;
    font-size: 0.95rem;
    color: var(--fg-muted);
  }
  .pricing-note strong {
    color: var(--fg);
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
  }
  h2 {
    margin-top: 2.5rem;
  }
  .table-wrap {
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  th,
  td {
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    text-align: left;
    vertical-align: top;
  }
  thead th {
    background: var(--bg-elevated);
    color: var(--fg);
  }
  tbody th {
    background: var(--bg-elevated);
    color: var(--fg-muted);
    font-weight: 600;
    width: 22%;
  }
  td {
    color: var(--fg-muted);
  }
  ul {
    padding-left: 1.25rem;
    color: var(--fg-muted);
  }
  ul li {
    margin: 0.5rem 0;
  }
  .cta {
    margin-top: 2.5rem;
  }
  .cta a {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--accent);
    border-radius: 0.5rem;
  }
  .cta a:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }
  .cta-pair {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
  }
  .cta-pair .primary {
    display: inline-block;
    padding: 0.75rem 1.6rem;
    background: var(--gh-maroon-600);
    color: #fff;
    border-radius: var(--gh-radius-pill);
    font-family: var(--gh-font-brand);
    font-weight: 600;
  }
  .cta-pair .primary:hover {
    background: var(--gh-maroon-700);
    text-decoration: none;
  }
  .cta-pair .secondary {
    display: inline-block;
    padding: 0.75rem 1.6rem;
    border: 2px solid var(--gh-navy-600);
    color: var(--gh-navy-600);
    border-radius: var(--gh-radius-pill);
    font-family: var(--gh-font-brand);
    font-weight: 600;
  }
  .cta-pair .secondary:hover {
    background: rgba(33, 75, 137, 0.07);
    text-decoration: none;
  }
</style>
