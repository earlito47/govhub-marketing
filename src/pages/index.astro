---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import Hero from '../components/Hero.astro';
import RfpChatSection from '../components/RfpChatSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import SolutionsGrid from '../components/SolutionsGrid.astro';
import SocialProofMarquee from '../components/SocialProofMarquee.astro';
import StatRow from '../components/StatRow.astro';
import TrustSection from '../components/TrustSection.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQSchema from '../components/seo/FAQSchema.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { PRIMARY_KEYWORD, SIGNUP_URL, TRIAL_DAYS } from '../config';
import { PRICE_RANGE, formatUsd } from '../data/pricing';
import { faqsForPage } from '../data/faqs';

// Primary term is single-sourced — see src/config.ts PRIMARY_KEYWORD.
// <title> keeps the exact-match phrase; the H1 carries it inside a real pitch.
const title = PRIMARY_KEYWORD.title;
// Rendered length must stay ≤160 chars (SERP truncation point).
const description = `GovHub is ${PRIMARY_KEYWORD.primary} for federal, state and local contractors: find and match bids, draft the proposal, score it and fill out the forms.`;

const features = [
  {
    title: 'Built for government work, not adapted to it',
    description:
      'Section L/M structure, evaluation-criteria alignment, and compliance matrices are the default, not a plugin bolted onto a commercial sales tool.',
    icon: 'capitol',
  },
  {
    title: 'Drafts that sound like your firm',
    description:
      'GovHub learns from your past-performance library and technical narrative, so the first draft reads like your best writer, not a generic template.',
    icon: 'pen',
  },
  {
    title: 'Compliance gaps caught before you submit',
    description:
      'Automated checks against FAR/DFARS clauses, Section 508, and set-aside requirements flag problems while there is still time to fix them.',
    icon: 'shield-check',
  },
  {
    title: 'Grows from your first bid to a full pipeline',
    description:
      'Works for a one-person shop answering its first federal RFP, and for multi-team pursuits with dozens of contributors.',
    icon: 'team',
  },
];

// The whole job in six steps, each one line and one link, so a first-time
// visitor sees the full platform without reading six feature pages. Replaced
// the three-step "upload, add company, draft" block (2026-10-31), which
// started after the bid was already found.
const steps = [
  { n: '1', icon: 'lantern', title: 'Find', body: 'Federal, state and local bids in one inbox, read from official sources every day.', href: '/solutions/government-contract-search/' },
  { n: '2', icon: 'map', title: 'Match', body: 'Ranked against your NAICS codes, states and set-asides, with the reason for each match.', href: '/solutions/government-contract-search/#matching' },
  { n: '3', icon: 'pickaxe', title: 'Read', body: 'Every requirement, instruction and evaluation factor pulled into a compliance matrix.', href: '/solutions/rfp-shredding/' },
  { n: '4', icon: 'pen', title: 'Write', body: 'A first draft of the proposal in your firm\u2019s voice, built from your company profile.', href: '/solutions/ai-proposal-generator/' },
  { n: '5', icon: 'gauge', title: 'Score', body: 'Graded against the evaluation criteria, with what to fix before you submit.', href: '/solutions/technical-writer-review/' },
  { n: '6', icon: 'checklist', title: 'Fill out forms', body: 'SF-33, SF-1449, reps and certs filled from your company profile.', href: '/solutions/form-autofiller/' },
];

const stats = [
  { value: `${formatUsd(PRICE_RANGE.low)}/mo`, label: 'Starting price' },
  { value: `${TRIAL_DAYS} days`, label: 'Free trial, no card' },
  { value: 'Federal · state · local', label: 'Solicitations supported' },
];

// Brands whose contracts GovHub proposal work has supported (owner-provided).
// Woodborne Solutions renders as a text wordmark until its logo is supplied.
const proofBrands = [
  { name: 'Lockheed Martin', logo: '/brand/logos/social-proof/lockheed-martin.png' },
  { name: 'Boeing', logo: '/brand/logos/social-proof/boeing.png' },
  { name: 'Raytheon', logo: '/brand/logos/social-proof/raytheon.png' },
  { name: 'SpaceX', logo: '/brand/logos/social-proof/spacex.png' },
  { name: 'BAE Systems', logo: '/brand/logos/social-proof/bae-systems.png' },
  { name: 'General Dynamics', logo: '/brand/logos/social-proof/general-dynamics.png' },
  { name: 'Sentinel Health', logo: '/brand/logos/social-proof/sentinel-health.png' },
  { name: 'Woodborne Solutions' },
  { name: 'Trident AI Solutions', logo: '/brand/logos/social-proof/trident-ai.png' },
  { name: 'Cardinality.ai', logo: '/brand/logos/social-proof/cardinality-ai.svg' },
];

const homeFaqs = faqsForPage('/');
---

<BaseLayout title={title} description={description}>
  <SchemaOrg
    type="SoftwareApplication"
    data={{
      name: 'GovHub',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description,
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: PRICE_RANGE.currency,
        lowPrice: PRICE_RANGE.low,
        highPrice: PRICE_RANGE.high,
        offerCount: PRICE_RANGE.offerCount,
      },
    }}
  />

  <main class="container">
    <Hero
      eyebrow="New: federal, state and local bid search, built in"
      title={PRIMARY_KEYWORD.h1}
      lede="Find the bids that fit your company. Then GovHub reads the RFP, fills out the forms and drafts a compliant proposal that sounds like your firm, in minutes, not weekends."
      primaryHref={SIGNUP_URL}
      primaryLabel="Start free trial"
      secondaryHref="/bids/"
      secondaryLabel="Browse open bids, free →"
      art="/brand/page-graphics/home-hero-strike-gold.svg"
      artAlt="Illustration of a prospector striking gold in a mountain stream, GovHub's Gold Country brand scene"
    />

    <RfpChatSection />

    <SocialProofMarquee brands={proofBrands} />
    <section class="block">
      <h2>One platform, from finding the bid to submitting it</h2>
      <p class="section-lede">
        Most contractors stitch this together from a bid service, a proposal
        writer and a folder of PDFs. GovHub does all six in one place.
      </p>
      <ol class="lifecycle">
        {steps.map((s) => (
          <li>
            <a class="step" href={s.href}>
              <span class="step-head">
                <span class="num">{s.n}</span>
                <span class="step-title">{s.title}</span>
                <Icon name={s.icon} size={22} class="step-icon" />
              </span>
              <span class="step-body">{s.body}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="block">
      <h2>Everything a proposal shop does, without hiring one</h2>
      <p class="section-lede">
        Finding bids, shredding, drafting, scoring, forms and formatting: the
        work that used to take a business developer and a proposal team, in one
        tool.
      </p>
      <FeatureGrid features={features} />
    </section>


    <section class="block">
      <h2>An end-to-end contract acquisition platform</h2>
      <p class="section-lede">
        From finding the bid to a submission-ready package, GovHub covers the
        whole job.
      </p>
      <SolutionsGrid mode="featured" />
      <p class="more-link"><a href="/solutions/">See all solutions →</a></p>
    </section>

    <section class="block tool-teaser">
      <div class="teaser-card">
        <Icon name="pan" size={32} />
        <div>
          <h2>Try the free compliance matrix generator, right now</h2>
          <p>
            Paste an RFP and get a compliance matrix in seconds. It runs in your
            browser, no login, nothing is uploaded.
          </p>
        </div>
        <a class="teaser-cta" href="/solutions/compliance-matrix-generator/">Open the free tool</a>
      </div>
    </section>

    <section class="block audience">
      <h2>Built for your side of the table</h2>
      <p class="section-lede">
        New to government contracting? GovHub is a Swiss Army knife for the
        small jobs: it finds the quotes and bids that fit, explains each one in
        plain English, fills out the forms and writes the response.
      </p>
      <ul>
        <li><a href="/bids/">Open government bids near you →</a></li>
        <li><a href="/for/small-business-contractors/">Small business contractors →</a></li>
        <li><a href="/for/system-integrators/">System integrators →</a></li>
      </ul>
    </section>

    <section class="block tool-teaser">
      <div class="teaser-card">
        <Icon name="chart" size={32} />
        <div>
          <h2>See which federal contracts expire in the next 12 months</h2>
          <p>
            The recompete watch ranks the largest expiring contracts quarter by
            quarter, with incumbents, agencies, and values from public
            USAspending data. Updated weekly, free, no login.
          </p>
        </div>
        <a class="teaser-cta" href="/insights/expiring-federal-contracts/">See expiring contracts</a>
      </div>
    </section>

    <TrustSection />

    <Testimonials heading="What government contractors say" />

    {homeFaqs.length > 0 && (
      <FAQSchema faqs={homeFaqs} heading="Frequently asked questions" />
    )}

    <StatRow stats={stats} />

    <CTABand
      heading="Dig up your next contract."
      sub="14 days free, no card, your first proposal is ready before the trial ends."
      secondaryHref="/pricing/"
      secondaryLabel="See pricing"
    />
  </main>
</BaseLayout>

<style>
  main {
    padding: 0 1.5rem 2rem;
  }
  .block {
    margin: 4rem 0;
  }
  .block > h2 {
    margin: 0 0 0.5rem;
  }
  .section-lede {
    color: var(--fg-muted);
    max-width: 40rem;
    margin: 0 0 1rem;
    font-size: 1.05rem;
  }
  /* Six compact linked cards: three across on desktop, two on a tablet, one
     on a phone. One line each, so the whole platform reads in a glance. */
  .lifecycle {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    margin: 1.5rem 0 0;
  }
  .step {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-elevated);
    border: 1.5px solid var(--border);
    border-radius: var(--gh-radius-md);
    padding: 1.1rem 1.25rem;
    box-shadow: var(--shadow);
    color: var(--fg);
    text-decoration: none;
  }
  .step:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .step-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.45rem;
  }
  .step-head :global(.step-icon) {
    margin-left: auto;
  }
  .num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--gh-navy-600);
    color: #fff;
    font-family: var(--gh-font-brand);
    font-weight: 700;
  }
  .step-title {
    font-family: var(--gh-font-brand);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .step-body {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .more-link {
    margin-top: 1rem;
    font-weight: 600;
  }
  .audience ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin: 0.5rem 0 0;
  }
  .audience a {
    font-weight: 600;
  }
  .teaser-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    background: var(--gh-tint-sun);
    border: 1.5px solid var(--border);
    border-radius: var(--gh-radius-md);
    padding: 1.75rem 2rem;
  }
  .teaser-card div {
    flex: 1;
    min-width: 16rem;
  }
  .teaser-card h2 {
    margin: 0 0 0.4rem;
    font-size: 1.35rem;
  }
  .teaser-card p {
    margin: 0;
    color: var(--fg-muted);
  }
  .teaser-cta {
    display: inline-block;
    padding: 0.7rem 1.5rem;
    background: var(--gh-maroon-600);
    color: #fff;
    border-radius: var(--gh-radius-pill);
    font-family: var(--gh-font-brand);
    font-weight: 600;
    white-space: nowrap;
    transition: background var(--gh-dur-fast) var(--gh-ease), transform var(--gh-dur-fast) var(--gh-ease);
  }
  .teaser-cta:hover {
    background: var(--gh-maroon-700);
    transform: translateY(-1px);
    text-decoration: none;
  }
</style>
