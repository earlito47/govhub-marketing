---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import FAQSchema from '../components/seo/FAQSchema.astro';
import CTABand from '../components/CTABand.astro';
import { CONTACT_EMAIL } from '../config';
import PageHero from '../components/PageHero.astro';

const faqs = [
  {
    question: 'Is my proposal data secure with GovHub?',
    answer:
      'Proposal content is encrypted in transit and stored with providers that encrypt it at rest, and each account can reach only its own data. GovHub does not use your proposal content to train AI models. GovHub is a commercial cloud service and is not designed for Controlled Unclassified Information. Contact us for current security documentation.',
  },
  {
    question: 'Does GovHub train AI models on my proposal data?',
    answer:
      'No. Your past-performance, pricing, and technical content are used to serve you, to draft and review your proposals, and are not used to train models or shared with other customers.',
  },
  {
    question: 'Does GovHub support single sign-on (SSO)?',
    answer:
      'Not yet. GovHub accounts sign in with a verified work email and password. SAML single sign-on is not available today. If your organization needs it, tell us; it shapes what we build next.',
  },
];
---

<BaseLayout
  title="Security at GovHub: How We Protect Your Data"
  description="How GovHub protects government proposal data: encryption, account isolation, restricted staff access, and a commitment not to train AI models on your content."
 ogImage="/brand/page-graphics/security-mountain-vault@2x.png">
  <main class="container">
    <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: 'Security', url: '/security/' }]} />

    <PageHero art="/brand/page-graphics/security-mountain-vault.svg">
      <header class="prose">
        <h1>Security at GovHub</h1>
        <p class="lede">
          Government contractors handle sensitive, sometimes controlled information.
          Security isn't a feature we bolted on. It's how the product is built.
        </p>
      </header>
    </PageHero>

    <article class="prose">

      <h2>How we protect your data</h2>
      <ul>
        <li><strong>Encryption:</strong> data is encrypted in transit (TLS), and our database and file storage providers encrypt it at rest.</li>
        <li><strong>Account isolation:</strong> database row-level security limits each account to its own data.</li>
        <li><strong>Restricted staff access:</strong> administrative access is limited to named GovHub staff, and their administrative actions are recorded in an append-only audit log.</li>
        <li><strong>Verified sign-in:</strong> new accounts confirm their email address with a one-time code.</li>
        <li><strong>Established cloud providers:</strong> GovHub runs on Supabase and Cloudflare, and your data is stored in the United States.</li>
      </ul>

      <h2>Your data stays yours</h2>
      <p>
        GovHub does not train AI models on your proposal content. Your past
        performance, pricing, and technical data are used solely to draft and
        review your proposals, never shared with other customers, never fed into
        a shared model.
      </p>

      <h2>What to keep out of GovHub</h2>
      <p>
        GovHub is a commercial cloud service for businesses preparing bids. It
        is not designed for Controlled Unclassified Information or classified
        data, so keep those out of it. For security documentation or to discuss
        your specific requirements, email
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>

      <p>
        See also how GovHub handles regulatory compliance in proposals on the
        <a href="/compliance/">compliance page</a>.
      </p>
    </article>

    <FAQSchema faqs={faqs} heading="Security: FAQ" />

    <CTABand
      heading="Have a security or compliance question?"
      sub="Talk to our team about your agency's requirements."
      primaryHref={`mailto:${CONTACT_EMAIL}`}
      primaryLabel="Email the team"
      secondaryHref="/compliance/"
      secondaryLabel="See compliance"
    />
  </main>
</BaseLayout>

<style>
  main { padding: 1rem 1.5rem 2rem; }
  .prose { max-width: 48rem; margin: 1rem 0; }
  .lede { font-size: 1.15rem; color: var(--fg-muted); }
  h2 { margin-top: 2.5rem; }
  ul { padding-left: 1.25rem; color: var(--fg-muted); }
  li { margin: 0.5rem 0; }
</style>
