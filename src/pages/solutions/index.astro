---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SolutionsGrid from '../../components/SolutionsGrid.astro';
import CTABand from '../../components/CTABand.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="Government Contracting Solutions & AI Tools"
  description="GovHub's tools for government contractors: contract search and bid matching, RFP shredding, AI proposal writing, proposal scoring and form autofill."
 ogImage="/brand/page-graphics/solutions-index-toolkit@2x.png">
  <main class="container">
    <Breadcrumbs
      items={[
        { name: 'Home', url: '/' },
        { name: 'Solutions', url: '/solutions/' },
      ]}
    />

    <PageHero art="/brand/page-graphics/solutions-index-toolkit.svg">
    <header class="prose">
      <h1>Everything you need to find, write and win government contracts</h1>
      <p class="lede">
        GovHub covers the whole job: finding federal, state and local bids that
        match your company, shredding the solicitation into a compliance matrix,
        drafting the proposal, scoring it before you submit and filling out the
        forms. Every tool is built around how government buys.
      </p>
    </header>
    </PageHero>

    <SolutionsGrid mode="all" />

    <CTABand
      heading="See GovHub on your own solicitation"
      sub="Start a free trial, or try the free compliance matrix generator, no login required."
      secondaryHref="/solutions/compliance-matrix-generator/"
      secondaryLabel="Try the free tool"
    />
  </main>
</BaseLayout>

<style>
  main {
    padding: 1rem 1.5rem 4rem;
  }
  .prose {
    max-width: 46rem;
    margin: 1rem 0 1rem;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--fg-muted);
    margin-top: 1rem;
  }
</style>
