---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import { glossary, pillars, getTerm, hrefForTerm, type GlossaryTerm } from '../../data/glossary';
import { SIGNUP_URL } from '../../config';

const title = 'Federal contracting glossary: terms and definitions';
const description =
  'Plain-English definitions of federal contracting terms: NAICS, CAGE, UEI, IDIQ, GWAC, set-asides, RFP, compliance matrix, and more. One term per page.';

// The hub now indexes the pillar pages rather than one URL per term, but it
// still lists every term so someone scanning for a word still finds it: each
// links to its anchor on the pillar that covers it.
const grouped = pillars.map((p) => ({
  pillar: p,
  terms: p.termSlugs.map((s) => getTerm(s)).filter(Boolean) as GlossaryTerm[],
}));

// Terms deliberately kept out of the pillars still deserve a row, pointing at
// whatever page owns the topic. See defersTo in data/glossary.ts.
const deferred = glossary.filter((t) => t.defersTo && !pillars.some((p) => p.termSlugs.includes(t.slug)));
---

<BaseLayout title={title} description={description}>
  <main class="container">
    <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: 'Glossary', url: '/glossary/' }]} />

    <header class="prose">
      <h1>Federal contracting glossary</h1>
      <p class="lede">
        The terms you hit in solicitations, registrations, and evaluations, explained
        in plain language, grouped so the terms you meet together are explained together.
      </p>
    </header>

    {grouped.map((g) => (
      <section class="group" aria-label={g.pillar.h1}>
        <h2><a href={`/glossary/${g.pillar.slug}/`}>{g.pillar.h1}</a></h2>
        <ul>
          {g.terms.map((t) => (
            <li>
              <a href={hrefForTerm(t.slug)}>
                <strong>{t.term}</strong>
                <span>{t.short}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {deferred.length > 0 && (
      <section class="group" aria-label="Also covered">
        <h2>Also covered</h2>
        <ul>
          {deferred.map((t) => (
            <li>
              <a href={hrefForTerm(t.slug)}>
                <strong>{t.term}</strong>
                <span>{t.short}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <CTABand
    heading="Know the terms? Now win the work."
    sub="GovHub turns a solicitation into a compliant, submitted proposal, faster."
    primaryHref={`${SIGNUP_URL}?utm_source=glossary`}
    primaryLabel="Start free trial"
    secondaryHref="/solutions/"
  />
</BaseLayout>

<style>
  header.prose {
    margin: 1rem 0 2rem;
  }
  .group {
    margin: 2.25rem 0 0;
  }
  .group h2 {
    font-size: 1.35rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--gh-line);
  }
  .group ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.75rem;
  }
  .group li a {
    display: block;
    height: 100%;
    padding: 1rem 1.1rem;
    background: var(--gh-surface);
    border: 1px solid var(--gh-line);
    border-radius: var(--gh-radius-sm);
    box-shadow: var(--gh-shadow-card);
  }
  .group li a:hover {
    border-color: var(--gh-teal-600);
    text-decoration: none;
  }
  .group strong {
    display: block;
    color: var(--gh-teal-700);
    margin-bottom: 0.25rem;
  }
  .group span {
    display: block;
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }
</style>
