  "narrative": {
    "intro": "8(a) Business Development set-aside obligated $6.7B in FY2026 to date across 8,621 awards, with an average award size of $777K and obligations down 51.1% year over year. The Department of Defense is the largest buyer, obligating $3.3B. Computer Systems Design Services, Other Computer Related Services, and Facilities Support Services lead industries with $821M, $687M, and $648M respectively. Top vendors include AKIMA FACILITIES OPERATIONS LLC ($90.4M), CHEROKEE NATION STRATEGIC PROGRAMS, L.L.C. ($74.3M), and ASRC FEDERAL TECHNOLOGY SOLUTIONS, LLC ($66M). Historical context shows obligations peaked at $15.1B in FY24 and are at $6.7B so far in FY26. The data are contract obligations and represent fiscal year to date totals for the current year.",
    "sections": [
      {
        "heading": "Which agencies drive FY2026 8(a) obligations?",
        "body": "The Department of Defense obligated $3.3B, making Defense the dominant buyer. The Department of Homeland Security obligated $588M and the Department of Health and Human Services obligated $586M. The Department of State, General Services Administration, and Department of Justice follow with $293M, $278M, and $223M respectively."
      },
      {
        "heading": "What industries capture the most 8(a) dollars in FY2026?",
        "body": "Computer Systems Design Services captured $821M and Other Computer Related Services captured $687M. Facilities Support Services captured $648M and Engineering Services captured $573M. Several professional services categories together account for large shares, including Administrative Management and General Management Consulting Services at $538M."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does the federal government award through 8(a) set-asides?",
      "a": "The federal government awarded $6.7B through 8(a) set-asides in FY2026 to date. The program recorded 8,621 awards with an average award size of $777K, and obligations are down 51.1% year over year."
    },
    {
      "q": "Which agencies use 8(a) set-asides the most?",
      "a": "The Department of Defense awarded the most 8(a) obligations at $3.3B. Other major buying agencies include the Department of Homeland Security at $588M and the Department of Health and Human Services at $586M, followed by the Department of State ($293M), General Services Administration ($278M), and Department of Justice ($223M)."
    },
    {
      "q": "Who are the largest 8(a) set-aside contractors?",
      "a": "AKIMA FACILITIES OPERATIONS LLC, CHEROKEE NATION STRATEGIC PROGRAMS, L.L.C., and ASRC FEDERAL TECHNOLOGY SOLUTIONS, LLC are the largest contractors by obligations at $90.4M, $74.3M, and $66M respectively. Other top vendors include DNI EMERGING TECHNOLOGIES, LLC ($52.2M) and RSI-QUANTITECH JV LLC ($50.7M)."
