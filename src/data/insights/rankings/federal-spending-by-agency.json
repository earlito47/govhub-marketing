  "narrative": {
    "intro": "The federal government obligated $518B in contracts in FY2026 to date. The Department of Defense obligated $267B. The Department of Veterans Affairs obligated $58.4B. The Department of Homeland Security obligated $53.2B. The Department of Energy obligated $46.4B. The General Services Administration obligated $19.7B. The Department of Health and Human Services obligated $14.5B. The National Aeronautics and Space Administration obligated $10.2B. The Department of Transportation obligated $9.2B. The Department of Agriculture obligated $6.8B. The Department of Justice obligated $6.7B. All figures are contract obligations, and current-year totals are partial (fiscal year to date). This ranking shows how contract obligations are distributed across agencies through the current fiscal period, with the Department of Defense holding the single largest commitment of obligated funds and several civilian agencies holding lower but still material obligation levels.",
    "sections": [
      {
        "heading": "Which agencies lead federal contract obligations?",
        "body": "The Department of Defense obligated $267B. The Department of Veterans Affairs obligated $58.4B, the Department of Homeland Security obligated $53.2B, and the Department of Energy obligated $46.4B. The General Services Administration obligated $19.7B, and the Department of Health and Human Services obligated $14.5B."
      },
      {
        "heading": "How do smaller agencies compare in contract obligations?",
        "body": "The National Aeronautics and Space Administration obligated $10.2B and the Department of Transportation obligated $9.2B. The Department of Agriculture obligated $6.8B and the Department of Justice obligated $6.7B. These agencies hold the lower obligations among the top ten by agency for FY2026 to date."
      }
    ]
  },
