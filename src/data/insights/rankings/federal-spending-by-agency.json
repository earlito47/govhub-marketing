  "narrative": {
    "intro": "The Department of Energy obligated $6.2B in federal contracts in FY2027 to date, the largest single-agency total in this ranking. The Department of Veterans Affairs obligated $5.9B, followed by the Department of Homeland Security at $2.1B. The combined total of contract obligations across the listed agencies is $21.9B. National Aeronautics and Space Administration obligated $1.4B, and both the Department of Health and Human Services and the General Services Administration obligated $1.2B each. Lower-tier agencies include the Department of Justice at $836M, the Department of the Treasury at $743M, the Department of Transportation at $522M, and the Department of Agriculture at $517M. All figures are contract obligations; current-year totals are partial (fiscal year to date). This snapshot shows how contract dollars are distributed across civilian and defense-adjacent agencies during the current fiscal period. Readers can use these figures to compare relative contract demand and procurement scale across agencies for FY2027 to date without inferring changes from prior years or making future projections.",
    "sections": [
      {
        "heading": "Which agencies hold the largest shares of FY2027 contract obligations?",
        "body": "The Department of Energy holds the largest share, obligated $6.2B. The Department of Veterans Affairs is second, obligated $5.9B. The Department of Homeland Security is third, obligated $2.1B."
      },
      {
        "heading": "How do smaller agencies compare in contract obligations?",
        "body": "The National Aeronautics and Space Administration obligated $1.4B. The Department of Health and Human Services and the General Services Administration obligated $1.2B each. The Department of Justice, the Department of the Treasury, the Department of Transportation, and the Department of Agriculture obligated $836M, $743M, $522M, and $517M respectively."
      }
    ]
  },
  "faq": [
    {
      "q": "Which federal agency spends the most on contracts?",
      "a": "The Department of Energy obligated $6.2B and therefore spends the most on contracts. The Department of Veterans Affairs obligated $5.9B and is the second-largest contracting agency in FY2027 to date."
    }
