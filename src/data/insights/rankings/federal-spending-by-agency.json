  "narrative": {
    "intro": "The federal government obligated $6.7B in contracts in FY2027 to date. The Department of Veterans Affairs obligated $3.9B, making Veterans Affairs the largest contracting agency so far this fiscal year. The Department of Energy obligated $593M and the National Aeronautics and Space Administration obligated $517M. Department of Justice obligated $337M, Department of the Treasury obligated $277M, and General Services Administration obligated $263M. Department of Homeland Security obligated $175M, Department of Agriculture obligated $129M, Department of Health and Human Services obligated $109M, and Department of Commerce obligated $94.6M. All figures are contract obligations; current-year totals are partial (fiscal year to date).",
    "sections": [
      {
        "heading": "Which agency leads FY2027 contract obligations?",
        "body": "The Department of Veterans Affairs obligated $3.9B in FY2027 to date. Department of Veterans Affairs accounts for the largest share of the $6.7B in total obligations recorded so far this fiscal year."
      },
      {
        "heading": "How do other agencies compare in FY2027 obligations?",
        "body": "The Department of Energy obligated $593M and the National Aeronautics and Space Administration obligated $517M. Department of Justice obligated $337M, Department of the Treasury obligated $277M, and General Services Administration obligated $263M. Department of Homeland Security obligated $175M, Department of Agriculture obligated $129M, Department of Health and Human Services obligated $109M, and Department of Commerce obligated $94.6M."
      }
    ]
