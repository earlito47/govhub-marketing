  "narrative": {
    "intro": "Federal contract obligations total $572B for FY2026 to date. The ranking lists contract obligations by state and reflects partial fiscal-year totals because FY2026 is still in progress. Virginia leads state obligations with $92.1B, followed by Texas with $82.9B and California with $47.1B. Maryland, Arizona, and the District Of Columbia report sizable obligations at $26.9B, $25.5B, and $23.8B respectively. Florida, Pennsylvania, Connecticut, and Massachusetts round out the top ten with $23.4B, $21.1B, $18.4B, and $14.6B respectively. Procurement teams and contractors tracking where federal buy dollars are concentrated should use these obligation totals as a snapshot of FY2026 to date, not as final fiscal-year figures. The totals shown are obligations, not payments or award counts, and they sum to part of the federal contracting activity recorded so far in the fiscal year. Stakeholders should treat the list as a current ranking by state rather than a year-end distribution of contract funds.",
    "sections": [
      {
        "heading": "Which state tops the FY2026 to date federal contract obligations?",
        "body": "Virginia has the largest federal contract obligations at $92.1B. Texas follows Virginia with $82.9B, and California ranks third with $47.1B. These totals are contract obligations reported for FY2026 to date."
      },
      {
        "heading": "How do the rest of the top ten states compare in obligations?",
        "body": "Maryland, Arizona, and the District Of Columbia report obligations of $26.9B, $25.5B, and $23.8B respectively. Florida has $23.4B, Pennsylvania has $21.1B, Connecticut has $18.4B, and Massachusetts has $14.6B. These figures are partial fiscal-year obligation totals for FY2026 to date."
      }
    ]
  },
  "faq": [
    {
      "q": "Which state gets the most federal contract money?",
      "a": "Virginia gets the most federal contract money. Virginia obligated $92.1B of the $572B in total federal contract obligations for FY2026 to date."
    }
  ],
