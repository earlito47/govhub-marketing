  "narrative": {
    "intro": "Federal contract obligations for FY2027 to date total $6.6B. Virginia leads the state-level ranking with $1.6B in obligations. California follows with $524M, and Texas follows with $500M. Pennsylvania and Florida appear next with $478M and $310M respectively. Illinois, the District Of Columbia, Maryland, New York, and Washington round out the top ten with $264M, $249M, $226M, $191M, and $175M. These figures are partial fiscal year to date totals and represent contract obligations rather than outlays or full-year projections. Contractors tracking opportunity or market share should note the geographic concentration in the top-ranked states, and that the total listed obligations reflect only the current fiscal period so far. Use the state-by-state values when comparing commercial presence to federal contracting activity within this fiscal year timeframe.",
    "sections": [
      {
        "heading": "Which states lead federal contract obligations in FY2027 to date?",
        "body": "Virginia obligated $1.6B. California obligated $524M, Texas obligated $500M, and Pennsylvania obligated $478M. Florida obligated $310M, and the remainder of the top ten includes Illinois $264M, District Of Columbia $249M, Maryland $226M, New York $191M, and Washington $175M."
      },
      {
        "heading": "What does the $6.6B total represent?",
        "body": "The total obligations across all states equal $6.6B for FY2027 to date. The figure represents contract obligations recorded in the current fiscal year to date, not final yearly totals or cash disbursements. Analysts should treat the total as a partial-year snapshot."
      }
    ]
  },
  "faq": [
    {
      "q": "Which state gets the most federal contract money?",
      "a": "Virginia receives the most federal contract obligations, at $1.6B. California is second with $524M, followed by Texas with $500M."
    }
  ],
