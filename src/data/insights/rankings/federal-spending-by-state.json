  "narrative": {
    "intro": "The United States has recorded $538B in federal contract obligations for FY2026 to date. Virginia leads state totals with $87.1B in obligations, followed by Texas at $78.1B and California at $43.7B. Maryland, Arizona, and Florida each record multi-billion dollar obligations: $25.2B, $24.9B, and $22.3B respectively. The District Of Columbia registers $22B, while Pennsylvania, Connecticut, and Massachusetts show $19.2B, $16B, and $14B. These figures reflect contract obligations through the fiscal year to date and are partial current-year totals. Federal contracting remains concentrated in a handful of states that host major agencies, defense contractors, and technology firms. Businesses and partners looking to pursue opportunities should note the absolute dollar scale of obligations by state, because large state totals often signal high levels of ongoing procurement activity and multiple awarding agencies. The list of top states provides a snapshot of where contract dollars are flowing so far in FY2026 to date.",
    "sections": [
      {
        "heading": "Which states lead in federal contract obligations?",
        "body": "Virginia leads with $87.1B in obligations. Texas follows with $78.1B, and California ranks third with $43.7B. Maryland, Arizona, and Florida also appear in the top ranks with $25.2B, $24.9B, and $22.3B respectively."
      },
      {
        "heading": "How do smaller top states compare to the leaders?",
        "body": "The District Of Columbia records $22B in obligations, close to Florida by absolute dollars. Pennsylvania, Connecticut, and Massachusetts report $19.2B, $16B, and $14B respectively, showing meaningful but smaller totals than the top three states."
      }
    ]
  },
  "faq": [
    {
      "q": "Which state gets the most federal contract money?",
      "a": "Virginia receives the most federal contract money, with $87.1B in obligations. Texas is second with $78.1B, and California is third with $43.7B."
    }
  ],
