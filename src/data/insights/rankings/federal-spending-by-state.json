  "narrative": {
    "intro": "Federal contract obligations across the states total $18.2B for FY2027 to date. Virginia leads state totals with $2.5B in obligations. Texas follows with $1.9B, and California follows with $1.8B. New Mexico holds $1.6B in obligations, and Tennessee holds $1.2B. The District Of Columbia has $714M and Maryland has $706M. Illinois recorded $691M, Pennsylvania recorded $654M, and Florida recorded $638M. These totals are fiscal year to date and therefore partial for FY2027. The listing shows how obligations are distributed across states in the top ten by dollar amount, without agency or industry breakdowns. Contractors and officials can use these state-level totals to compare scale and presence while recognizing the totals are not final for the full fiscal year.",
    "sections": [
      {
        "heading": "Which states receive the largest share of FY2027 federal contract obligations?",
        "body": "Virginia received $2.5B in obligations, the largest state total. Texas received $1.9B and California received $1.8B, making them the next two largest state totals. New Mexico received $1.6B and Tennessee received $1.2B."
      },
      {
        "heading": "How concentrated are obligations across the top ten states?",
        "body": "The top five states by obligations are Virginia, Texas, California, New Mexico, and Tennessee, with totals from $2.5B down to $1.2B. The next five in the top ten are the District Of Columbia, Maryland, Illinois, Pennsylvania, and Florida, with totals from $714M down to $638M. The listed state totals are part of the $18.2B in FY2027 to date obligations."
      }
    ]
  },
  "faq": [
    {
      "q": "Which state gets the most federal contract money?",
      "a": "Virginia receives the most federal contract money, with $2.5B in obligations. Texas is second with $1.9B, and California is third with $1.8B."
    }
  ],
