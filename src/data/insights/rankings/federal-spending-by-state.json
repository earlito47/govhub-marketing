  "narrative": {
    "intro": "This page ranks federal contract obligations by state for FY2027 to date. Total obligations across all states listed equal $21.5B. Virginia leads the list with $3B in obligations, followed by Texas with $2.2B and California with $2.1B. New Mexico, Tennessee, Maryland, and the District Of Columbia each record seven-figure totals, with New Mexico at $1.6B, Tennessee at $1.2B, Maryland at $1.1B, and the District Of Columbia at $1B. Florida, Illinois, and Pennsylvania register smaller seven-figure totals, with Florida at $767M, Illinois at $724M, and Pennsylvania at $696M. All figures are contract obligations and current-year totals are partial because the fiscal year is in progress. Use these figures to compare where federal contracting dollars have been obligated so far in the fiscal year. The ranking reflects obligations only and does not indicate contract counts, award types, or end-user sectors. Review agency-level data for more detail if you need to break these totals into program or procurement categories.",
    "sections": [
      {
        "heading": "Which states lead FY2027 to date federal contract obligations?",
        "body": "Virginia is the top state with $3B in federal contract obligations. Texas follows with $2.2B and California with $2.1B. New Mexico is next with $1.6B, then Tennessee with $1.2B."
      },
      {
        "heading": "How are obligations distributed among the top ten states?",
        "body": "The top ten states listed together account for the $21.5B in obligations. Maryland records $1.1B and the District Of Columbia records $1B. Florida records $767M, Illinois records $724M, and Pennsylvania records $696M."
      }
    ]
  },
  "faq": [
    {
      "q": "Which state gets the most federal contract money?",
      "a": "Virginia receives the most federal contract money: $3B. Texas is second with $2.2B and California is third with $2.1B."
    }
  ],
