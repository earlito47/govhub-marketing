  "narrative": {
    "intro": "Federal contract obligations totaled $498B through FY2026 to date. The top recipients by state show a concentration along the East Coast and in large population centers. Virginia leads with $75.5B, followed closely by Texas with $71.8B and California with $41.4B. Maryland, Arizona, Florida, and the District Of Columbia each received between $20.8B and $24.1B in obligations. Mid-tier recipients in the top ten include Pennsylvania at $18.7B, Connecticut at $15.9B, and New Mexico at $13.3B. These figures reflect contract obligations rather than grants or other federal payments, and the totals are partial because they cover the fiscal year to date. Contractors and state officials can use these totals to understand where federal buying is concentrated so far in the fiscal year and to compare their state position against the national total of $498B in obligations through FY2026 to date.",
    "sections": [
      {
        "heading": "Which states lead federal contract obligations?",
        "body": "Virginia leads federal contract obligations with $75.5B. Texas follows with $71.8B. California ranks third with $41.4B."
      },
      {
        "heading": "How do the next-ranked states compare to the leaders?",
        "body": "Maryland recorded $24.1B in obligations and Arizona recorded $22.7B. Florida posted $21.5B and the District Of Columbia posted $20.8B. Pennsylvania, Connecticut, and New Mexico reported $18.7B, $15.9B, and $13.3B respectively."
      }
    ]
  },
  "faq": [
    {
      "q": "Which state gets the most federal contract money?",
      "a": "Virginia receives the most federal contract money, with $75.5B in obligations. The national total of federal contract obligations through FY2026 to date is $498B, and Virginia’s $75.5B is the largest single-state share listed."
    }
  ],
