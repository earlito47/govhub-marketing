  "narrative": {
    "intro": "This table shows federal contract obligations by state for FY2026 to date. Total obligations across all states are $672B. Virginia received $109B, the largest single-state total in this ranking. Texas received $93.5B and California received $54B, making those three the top recipients so far in the fiscal year. Maryland received $34.6B and the District Of Columbia received $30.4B. Arizona received $29.3B, Florida received $27.9B, and Pennsylvania received $23.7B. Connecticut received $19.6B and Washington received $18.5B. All figures are contract obligations and the current-year totals are partial because the fiscal year is still in progress. Use these figures to compare scale and to prioritize outreach or business development where the largest contract flows are already present in FY2026 to date.",
    "sections": [
      {
        "heading": "Which states lead federal contract obligations in FY2026 to date?",
        "body": "Virginia received $109B and leads the list. Texas received $93.5B and California received $54B, placing them second and third. Maryland, the District Of Columbia, and Arizona round out the next group with $34.6B, $30.4B, and $29.3B respectively."
      },
      {
        "heading": "How should contractors view the FY2026 to date totals?",
        "body": "The totals are contract obligations and reflect partial fiscal-year activity. Virginia, Texas, and California represent the largest absolute pools of obligations so far in FY2026 to date, which can guide market focus and competitive efforts."
      }
    ]
  },
  "faq": [
    {
      "q": "Which state gets the most federal contract money?",
      "a": "Virginia received $109B. Virginia is the top state for federal contract obligations in FY2026 to date, followed by Texas with $93.5B and California with $54B."
    }
