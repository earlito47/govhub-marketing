  "narrative": {
    "intro": "The federal government obligated $612B in contract dollars in FY2026 to date. Virginia obligated $97B, making Virginia the largest recipient of federal contract obligations in this period. Texas obligated $87.9B and California obligated $49.5B. Maryland obligated $29.1B, Arizona obligated $26.5B, and the District Of Columbia obligated $26B. Florida obligated $24.9B, Pennsylvania obligated $22.3B, Connecticut obligated $19B, and Washington obligated $17.2B. The list above ranks the top ten states and the District Of Columbia by contract obligations for FY2026 to date. These figures are obligations and represent current-year totals that are partial because the fiscal year is still in progress. Readers should treat these numbers as year-to-date totals rather than final annual totals. The ranking shows which states and the District Of Columbia received the largest cumulative contract obligations so far in the fiscal year.",
    "sections": [
      {
        "heading": "Which states lead federal contract obligations in FY2026 to date?",
        "body": "Virginia obligated $97B. Texas obligated $87.9B and California obligated $49.5B. Maryland, Arizona, and the District Of Columbia follow with $29.1B, $26.5B, and $26B respectively."
      },
      {
        "heading": "What do the top-ten state obligations tell contractors right now?",
        "body": "The top-ten ranking lists Virginia, Texas, California, Maryland, Arizona, the District Of Columbia, Florida, Pennsylvania, Connecticut, and Washington by obligation totals. Florida obligated $24.9B, Pennsylvania obligated $22.3B, Connecticut obligated $19B, and Washington obligated $17.2B. These figures are fiscal year to date and reflect partial current-year obligations."
      }
    ]
  },
  "faq": [
    {
      "q": "Which state gets the most federal contract money?",
      "a": "Virginia receives the most federal contract money. Virginia obligated $97B, and total federal contract obligations are $612B in FY2026 to date."
    }
  ],
