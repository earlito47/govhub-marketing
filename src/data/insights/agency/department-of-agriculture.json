  "narrative": {
    "intro": "The Department of Agriculture obligated $7.5B in federal contracts in FY2026 to date. Obligations fell 21.2% year over year, with 21,989 awards and an average award size of $343K. Fiscal-year obligations peaked at $11.6B in FY24 and declined to $9.6B in FY25 before reaching $7.5B in FY26 to date. Nonscheduled Chartered Freight Air Transportation is the largest NAICS category at $818M, followed by Fruit and Vegetable Canning at $462M and Highway, Street, and Bridge Construction at $461M. KIEWIT INFRASTRUCTURE SOUTH CO is the largest vendor at $261M, followed by TYSON FOODS INC. at $176M and PALANTIR TECHNOLOGIES INC. at $129M. The data reflect current-year totals that are partial because FY2026 is fiscal year to date.",
    "sections": [
      {
        "heading": "How have obligations trended over recent fiscal years?",
        "body": "The Department of Agriculture's obligations rose from $9.7B in FY21 to $11.6B in FY24, then fell to $9.6B in FY25 and to $7.5B in FY26 to date. Obligations fell 21.2% year over year between FY25 and FY26 to date."
      },
      {
        "heading": "What are the biggest categories and vendors this year?",
        "body": "Nonscheduled Chartered Freight Air Transportation leads NAICS categories at $818M, with Fruit and Vegetable Canning at $462M and Highway, Street, and Bridge Construction at $461M. KIEWIT INFRASTRUCTURE SOUTH CO tops vendors at $261M, followed by TYSON FOODS INC. at $176M and PALANTIR TECHNOLOGIES INC. at $129M."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does Department of Agriculture spend on contracts?",
      "a": "The Department of Agriculture obligated $7.5B on contracts in FY2026 to date. The agency recorded 21,989 awards with an average award size of $343K, and obligations fell 21.2% year over year."
    },
    {
      "q": "What does Agriculture buy?",
      "a": "The Department of Agriculture buys a mix of services and products across food processing, construction, transportation, forestry, and IT. Top categories in FY2026 to date include Nonscheduled Chartered Freight Air Transportation at $818M; Fruit and Vegetable Canning at $462M; Highway, Street, and Bridge Construction at $461M; and several food manufacturing and computer services categories."
    },
    {
      "q": "Who are Agriculture's largest contractors?",
      "a": "KIEWIT INFRASTRUCTURE SOUTH CO is the largest contractor to the Department of Agriculture at $261M, followed by TYSON FOODS INC. at $176M and PALANTIR TECHNOLOGIES INC. at $129M. Other top vendors include PACIFIC COAST PRODUCERS at $122M and HELICOPTER TRANSPORT SERVICES, LLC at $116M."
    }
