  "narrative": {
    "intro": "The Department of Veterans Affairs obligated $74.2B on federal contracts in FY2026 to date. The Department of Veterans Affairs issued 63,720 awards with an average award size of $1.2M, and obligations are down 5.3% year over year. The Department of Veterans Affairs continues a multi-year rise in contract spending from $47.7B in FY21 through $78.3B in FY25, with the current fiscal-year-to-date total of $74.2B. The Department of Veterans Affairs concentrates spending in health-related NAICS categories and a mix of IT and construction services, and a small set of vendors dominate the dollar totals.",
    "sections": [
      {
        "heading": "What is the short-term trend in VA contracting?",
        "body": "The Department of Veterans Affairs obligated $74.2B in FY2026 to date, which is down 5.3% year over year. The Department of Veterans Affairs reached $78.3B in FY25 after a steady rise from $47.7B in FY21."
      },
      {
        "heading": "Where do VA contract dollars go by category and vendor?",
        "body": "Direct Health and Medical Insurance Carriers received $29.4B and Pharmaceutical Preparation Manufacturing received $12.3B, followed by Offices of Physicians (except Mental Health Specialists) at $7.6B. OPTUM PUBLIC SECTOR SOLUTIONS, INC. received $19.9B and MCKESSON CORPORATION received $12B, with TRIWEST HEALTHCARE ALLIANCE CORP at $9.8B and several other vendors in the multi-hundred-million to low-single-billion range."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does Department of Veterans Affairs spend on contracts?",
      "a": "The Department of Veterans Affairs obligated $74.2B on contracts in FY2026 to date. The Department of Veterans Affairs issued 63,720 awards, the average award size was $1.2M, and obligations were down 5.3% year over year."
    },
    {
      "q": "What does Veterans Affairs buy?",
      "a": "The Department of Veterans Affairs buys health care services, pharmaceuticals, physician services, IT services, and construction. Direct Health and Medical Insurance Carriers received $29.4B, Pharmaceutical Preparation Manufacturing received $12.3B, Offices of Physicians (except Mental Health Specialists) received $7.6B, Computer Systems Design Services received $3.9B, and Commercial and Institutional Building Construction received $3B."
    },
    {
      "q": "Who are Veterans Affairs's largest contractors?",
      "a": "OPTUM PUBLIC SECTOR SOLUTIONS, INC. is the largest contractor at $19.9B. MCKESSON CORPORATION received $12B, TRIWEST HEALTHCARE ALLIANCE CORP received $9.8B, QTC MEDICAL SERVICES INC received $2.2B, and OPTUMSERVE HEALTH SERVICES, INC. and LOYAL SOURCE GOVERNMENT SERVICES LLC each received $1.8B."
    }
