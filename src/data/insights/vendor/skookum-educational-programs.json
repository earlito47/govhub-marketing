  "narrative": {
    "intro": "Skookum Educational Programs has $262M in contract obligations in FY2026 to date. Skookum Educational Programs won 391 awards this fiscal year to date, with an average award size of $670K, and obligations are up 12.5% year over year. Department of Defense is the largest buyer, obligating $219M so far in FY2026. Facilities Support Services is the dominant market, accounting for $231M of obligations, followed by Janitorial Services at $15.2M. Historical obligations show steady growth from $184M in FY21 to $262M in FY26. The FY2026 portfolio is concentrated in services and facility support, with smaller obligations across energy, health, and diplomatic missions: Department of Homeland Security $20.8M, Department of Energy $10.6M, and Department of Health and Human Services $6.2M. This fiscal-year snapshot covers partial current-year totals and contract obligations unless otherwise noted for award-value tables.",
    "sections": [
      {
        "heading": "Who are Skookum Educational Programs' top government customers?",
        "body": "Department of Defense is the top buyer, obligating $219M in FY2026 to date. Department of Homeland Security follows with $20.8M, and Department of Energy follows with $10.6M. Other agencies with notable obligations include Department of Health and Human Services $6.2M and Department of State $4.9M."
      },
      {
        "heading": "What services and markets drive Skookum Educational Programs' federal work?",
        "body": "Facilities Support Services is the largest market, with $231M in FY2026 to date. Janitorial Services is the next-largest market with $15.2M, and Administrative Management and General Management Consulting Services and Landscaping Services each have $3.2M. The portfolio also includes Food Service Contractors $2.9M and several smaller service and maintenance markets."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does Skookum Educational Programs make from federal contracts?",
      "a": "Skookum Educational Programs has received $262M in contract obligations in FY2026 to date. Skookum Educational Programs won 391 awards this fiscal year to date, with an average award size of $670K, and obligations are up 12.5% year over year."
