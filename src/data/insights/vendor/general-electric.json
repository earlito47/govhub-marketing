  "narrative": {
    "intro": "General Electric shows $1.4B in federal contract obligations for FY2026 to date. General Electric won 864 awards this fiscal year to date, with an average award size of $1.7M. Obligations fell 26.4% year over year. The Department of Defense obligated $1.3B to General Electric this year to date, making defense work the dominant source of federal spending for the company. Historical obligations by fiscal year were $2B in FY21, $1.4B in FY22, $2.3B in FY23, $1.6B in FY24, $1.9B in FY25, and $1.4B in FY26. Aircraft Engine and Engine Parts Manufacturing is the largest market for General Electric at $1.3B this year to date, followed by Aircraft Manufacturing at $74.1M and Other Aircraft Parts and Auxiliary Equipment Manufacturing at $39.2M. Department of Homeland Security obligations total $93.1M.",
    "sections": [
      {
        "heading": "Which agencies are buying from General Electric?",
        "body": "The Department of Defense is the top buyer, obligating $1.3B this fiscal year to date. The Department of Homeland Security follows with $93.1M in obligations. Other agency entries are not summarized here."
      },
      {
        "heading": "What product and service markets does General Electric serve for the government?",
        "body": "Aircraft Engine and Engine Parts Manufacturing is the largest market, with $1.3B in obligations this year to date. Other significant markets include Aircraft Manufacturing at $74.1M, Other Aircraft Parts and Auxiliary Equipment Manufacturing at $39.2M, Commercial and Industrial Machinery and Equipment Repair and Maintenance at $29.8M, Hardware Manufacturing at $24.2M, and Engineering Services at $127K."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does General Electric make from federal contracts?",
      "a": "General Electric has $1.4B in federal contract obligations for FY2026 to date. General Electric received 864 awards this fiscal year to date, with an average award size of $1.7M, and obligations are down 26.4% year over year. Historical annual obligations were $2B in FY21, $1.4B in FY22, $2.3B in FY23, $1.6B in FY24, and $1.9B in FY25."
    },
    {
      "q": "Which agencies buy from General Electric?",
      "a": "The Department of Defense is the primary buyer, obligating $1.3B to General Electric this fiscal year to date. The Department of Homeland Security obligated $93.1M."
    },
    {
      "q": "What does General Electric sell to the government?",
      "a": "General Electric sells aircraft-related products and services to the government, led by Aircraft Engine and Engine Parts Manufacturing at $1.3B this year to date. General Electric also sells Aircraft Manufacturing items at $74.1M, Other Aircraft Parts and Auxiliary Equipment at $39.2M, Commercial and Industrial Machinery and Equipment Repair and Maintenance at $29.8M, Hardware Manufacturing at $24.2M, and Engineering Services at $127K."
