  "narrative": {
    "intro": "Serco obligated $800M in federal contract obligations in FY2026 to date, across 374 awards with an average award size of $2.1M, and obligations fell 38.4% year over year. The Department of Defense is the largest buyer, obligating $494M, followed by the Department of Health and Human Services with $202M and the Pension Benefit Guaranty Corporation with $39.9M. Engineering Services, Computer Systems Design Services, and Security Systems Services are the largest NAICS markets, with obligations of $274M, $196M, and $90M respectively. Fiscal-year historical context shows obligations of $773M in FY21, $868M in FY22, $1.1B in FY23, $1.5B in FY24, and $1.3B in FY25. The top markets also include Administrative Management and General Management Consulting Services with $69.7M and Other Communications Equipment Manufacturing with $38.1M. The Department of Transportation and Department of Labor are secondary buyers with $26.5M and $14.2M in obligations. These figures reflect fiscal year to date totals and include complete award counts and average award size.",
    "sections": [
      {
        "heading": "What drove Serco's FY2026 obligations?",
        "body": "The Department of Defense drove the largest share of Serco's obligations with $494M. Major market demand in Engineering Services and Computer Systems Design Services also supported obligations of $274M and $196M. Health programs through the Department of Health and Human Services contributed $202M to the total."
      },
      {
        "heading": "Where are Serco's obligations concentrated?",
        "body": "Engineering Services and Computer Systems Design Services together account for a substantial portion of FY2026 obligations with $274M and $196M. Security Systems Services and Administrative Management and General Management Consulting Services add $90M and $69.7M respectively. The Department of Defense and Department of Health and Human Services represent the top agency concentration with $494M and $202M."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does Serco make from federal contracts?",
      "a": "Serco made $800M in federal contract obligations in FY2026 to date. Serco recorded 374 awards with an average award size of $2.1M, and obligations fell 38.4% year over year."
    },
    {
      "q": "Which agencies buy from Serco?",
      "a": "The Department of Defense buys the most from Serco, obligating $494M. The Department of Health and Human Services follows with $202M, and the Pension Benefit Guaranty Corporation is next with $39.9M."
    },
    {
      "q": "What does Serco sell to the government?",
