  "narrative": {
    "intro": "Amentum Services recorded $2.7B in federal contract obligations in FY2026 to date. Amentum Services won 568 awards so far this fiscal year, with an average award size of $4.8M. Amentum Services obligations fell 22.5% year over year. Amentum Services has trended up from $1.4B in FY21 to a peak of $3.8B in FY24, then moved to $3.5B in FY25 and to $2.7B in FY26. The Department of Defense is the largest buyer, obligating $1.8B, followed by the Department of Homeland Security with $733M and the General Services Administration with $102M. Other meaningful markets include Other Support Activities for Air Transportation at $990M, Security Guards and Patrol Services at $507M, and Engineering Services at $339M. Amentum Services also delivers Facilities Support Services at $250M and Computer Facilities Management Services at $125M. This profile reflects fiscal-year-to-date obligations and partial current-year totals.",
    "sections": [
      {
        "heading": "Who are the biggest federal buyers of Amentum Services this year?",
        "body": "The Department of Defense obligated $1.8B to Amentum Services in FY2026 to date. The Department of Homeland Security obligated $733M. The General Services Administration obligated $102M, and the Department of the Treasury obligated $87.3M. Other agencies with obligations include the Department of State at $29.3M and NASA at $21.9M."
      },
      {
        "heading": "What service areas drive Amentum Services obligations?",
        "body": "Other Support Activities for Air Transportation is the largest market at $990M. Security Guards and Patrol Services and Engineering Services follow at $507M and $339M respectively. Facilities Support Services, General Warehousing and Storage, and Computer Facilities Management Services also contribute with $250M, $132M, and $125M."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does Amentum Services make from federal contracts?",
      "a": "Amentum Services has $2.7B in contract obligations in FY2026 to date. Amentum Services won 568 awards this fiscal year, with an average award size of $4.8M. Obligations fell 22.5% year over year."
