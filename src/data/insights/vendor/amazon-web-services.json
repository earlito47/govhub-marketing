  "narrative": {
    "intro": "Amazon Web Services obligated $570M in FY2026 to date. Amazon Web Services received 119 awards so far this fiscal year, with an average award size of $4.8M and obligations up 81.4% year over year. Annual obligations grew from $39.2M in FY21 to $27.3M in FY22, then rose to $98.6M in FY23, $246M in FY24, and $314M in FY25 before reaching $570M in FY26. The Department of Defense is the largest federal buyer, obligating $376M to Amazon Web Services in FY2026 to date, followed by the Department of Homeland Security at $103M and the General Services Administration at $33.5M. Computing Infrastructure Providers, Data Processing, Web Hosting, and Related Services is the dominant market for Amazon Web Services, accounting for $545M of obligations, with Computer Systems Design Services next at $23.7M. This profile shows concentrated demand from defense and cloud infrastructure spending so far this fiscal year.",
    "sections": [
      {
        "heading": "Who are the biggest buyers of Amazon Web Services in FY2026 to date?",
        "body": "The Department of Defense obligated $376M to Amazon Web Services. The Department of Homeland Security obligated $103M and the General Services Administration obligated $33.5M. Other buyers include the Department of Justice at $25.6M and the Department of Energy at $24.5M."
      },
      {
        "heading": "What markets and services dominate Amazon Web Services federal obligations?",
        "body": "Computing Infrastructure Providers, Data Processing, Web Hosting, and Related Services accounted for $545M of obligations. Computer Systems Design Services accounted for $23.7M and Custom Computer Programming Services accounted for $2.1M. Research and Development in the Physical, Engineering, and Life Sciences accounted for $500 and Other Computer Related Services accounted for $0."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does Amazon Web Services make from federal contracts?",
      "a": "Amazon Web Services obligated $570M in FY2026 to date under federal contracts. Amazon Web Services received 119 awards this fiscal year with an average award size of $4.8M, and obligations are up 81.4% year over year. Annual obligations rose from $39.2M in FY21 to $570M in FY26, showing increasing federal spending on AWS over the period."
    },
    {
      "q": "Which agencies buy from Amazon Web Services?",
      "a": "The Department of Defense, the Department of Homeland Security, and the General Services Administration are the largest buyers of Amazon Web Services. The Department of Defense obligated $376M, the Department of Homeland Security obligated $103M, and the General Services Administration obligated $33.5M in FY2026 to date. Other buying agencies include the Department of Justice at $25.6M and the Department of Energy at $24.5M."
    },
    {
      "q": "What does Amazon Web Services sell to the government?",
      "a": "Amazon Web Services primarily sells cloud and related computing services to the government. Computing Infrastructure Providers, Data Processing, Web Hosting, and Related Services accounted for $545M of obligations, with Computer Systems Design Services at $23.7M and Custom Computer Programming Services at $2.1M. Smaller reported markets include Research and Development in the Physical, Engineering, and Life Sciences at $500 and Other Computer Related Services at $0."
    },
