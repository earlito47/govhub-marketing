  "narrative": {
    "intro": "Mantech Advanced Systems International obligated $750M in federal contracts in FY2026 to date, across 120 awards with an average award size of $6.2M, a pace that is down 25.3% year over year. The General Services Administration is the largest buyer, obligating $425M, followed by the Department of Defense at $243M. Computer Systems Design Services is the largest market for Mantech, with $382M obligated, and All Other Support Activities for Transportation and Engineering Services are the next-largest markets with $142M and $124M respectively. Historical obligations show variability: FY21 was $901M, FY22 was $1.1B, FY23 was $884M, FY24 was $1.2B, and FY25 was $1B. The current-year totals are partial and represent fiscal year to date activity. Top agency and market concentrations highlight where buying is concentrated this fiscal year, while the award count and average award size summarize contracting activity volume and scale for FY2026 to date.",
    "sections": [
      {
        "heading": "Who are the main buyers of Mantech Advanced Systems International in FY2026 to date?",
        "body": "The General Services Administration is the main buyer, obligating $425M. The Department of Defense follows with $243M. Other notable buyers include the Department of the Interior with $20.4M and the Department of State with $17.9M."
      },
      {
        "heading": "What markets and services account for Mantech Advanced Systems International's FY2026 to date obligations?",
        "body": "Computer Systems Design Services accounts for $382M in obligations. All Other Support Activities for Transportation and Engineering Services account for $142M and $124M respectively. Additional markets include Other Scientific and Technical Consulting Services at $30.7M and Custom Computer Programming Services at $23.6M."
      }
    ]
  },
