  "narrative": {
    "intro": "Geo Group has received $86.5M in federal contract obligations in FY2027 to date. Geo Group won 32 awards so far this fiscal year, with an average award size of $2.7M, and obligations fell 91.4% year over year. Fiscal-year obligations peaked at $1B in FY26 before dropping to $86.5M in FY27. The Department of Homeland Security is the largest buyer so far, with $74.4M in obligations, followed by the Department of Justice with $12.1M. Security Guards and Patrol Services is the largest market for Geo Group this year, with $52.7M in obligations, followed by Facilities Support Services at $17.8M and Correctional Institutions at $10.3M. Current-year totals are partial and represent fiscal year to date activity. These figures reflect contract obligations rather than total contract value, except where award-value tables are explicitly called out as total contract values.",
    "sections": [
      {
        "heading": "How has Geo Group's federal business trended this year?",
        "body": "Geo Group obligated $86.5M in FY2027 to date, down 91.4% year over year. Geo Group received 32 awards this fiscal year, with an average award size of $2.7M. Fiscal obligations rose from $609M in FY22 to $1B in FY26 before falling to $86.5M in FY27."
      },
      {
        "heading": "Who are Geo Group's biggest federal customers and markets?",
        "body": "The Department of Homeland Security obligated $74.4M and the Department of Justice obligated $12.1M in FY2027 to date. Security Guards and Patrol Services is the largest market at $52.7M, followed by Facilities Support Services at $17.8M and Correctional Institutions at $10.3M."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does Geo Group make from federal contracts?",
      "a": "Geo Group has received $86.5M in federal contract obligations in FY2027 to date. Geo Group has 32 awards this fiscal year with an average award size of $2.7M, and obligations fell 91.4% year over year. Historical obligations were $609M in FY22, $604M in FY23, $642M in FY24, $791M in FY25, and $1B in FY26."
    },
    {
      "q": "Which agencies buy from Geo Group?",
      "a": "The Department of Homeland Security has obligated $74.4M and the Department of Justice has obligated $12.1M in FY2027 to date. Those two agencies are the top buyers listed for the current fiscal year."
    },
    {
      "q": "What does Geo Group sell to the government?",
      "a": "Geo Group sells Security Guards and Patrol Services, Facilities Support Services, Correctional Institutions, and other justice and safety activities. Security Guards and Patrol Services is the largest market at $52.7M, Facilities Support Services is $17.8M, Correctional Institutions is $10.3M, and Other Justice, Public Order, and Safety Activities is $5.7M in FY2027 to date."
    },
