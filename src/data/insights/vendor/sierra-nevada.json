  "narrative": {
    "intro": "Sierra Nevada obligated $1.9B in federal contract obligations in FY2026 to date. Sierra Nevada won 38 awards so far, with an average award size of $49.7M and obligations down 15.8% year over year. The Department of Defense is the dominant buyer, obligating $1.9B. The Department of Homeland Security obligated $35K. Aircraft Manufacturing is Sierra Nevada's largest market at $1.5B, followed by All Other Professional, Scientific, and Technical Services at $306M and Search, Detection, Navigation, Guidance, Aeronautical, and Nautical System and Instrument Manufacturing at $114M. Fiscal-year obligations rose across FY21 through FY25 before the current-year decline: FY21 was $112M, FY22 was $539M, FY23 was $699M, FY24 was $1.3B, FY25 was $2.2B, and FY26 is $1.9B. The figures for award values and expiring contracts are noted as total contract values where applicable. This snapshot covers federal contracting activity through the current fiscal year to date.",
    "sections": [
      {
        "heading": "Who are Sierra Nevada's biggest buyers?",
        "body": "The Department of Defense obligated $1.9B from Sierra Nevada in FY2026 to date. The Department of Homeland Security obligated $35K. Those two agencies are the top buyers listed for the current fiscal-year period."
      },
      {
        "heading": "What are Sierra Nevada's primary markets and how large are they?",
        "body": "Aircraft Manufacturing is Sierra Nevada's largest market at $1.5B. All Other Professional, Scientific, and Technical Services is $306M, and Search, Detection, Navigation, Guidance, Aeronautical, and Nautical System and Instrument Manufacturing is $114M. Remaining listed markets include Computer Systems Design Services at $4.7M, All Other Telecommunications at $3.8M, Research and Development in the Physical, Engineering, and Life Sciences at $2.7M, and Other Guided Missile and Space Vehicle Parts and Auxiliary Equipment Manufacturing at $20K."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does Sierra Nevada make from federal contracts?",
      "a": "Sierra Nevada made $1.9B from federal contract obligations in FY2026 to date. Sierra Nevada's award count for the period is 38 and the average award size is $49.7M. Obligations are down 15.8% year over year."
    },
    {
      "q": "Which agencies buy from Sierra Nevada?",
      "a": "The Department of Defense is Sierra Nevada's largest buyer at $1.9B. The Department of Homeland Security is also listed, at $35K."
    },
    {
      "q": "What does Sierra Nevada sell to the government?",
      "a": "Sierra Nevada sells aircraft and related systems and services to the government, with Aircraft Manufacturing totaling $1.5B. Sierra Nevada also sells professional, scientific, and technical services totaling $306M, search and navigation systems totaling $114M, plus computer systems design, telecommunications, R&D, and guided missile and space vehicle parts in smaller amounts."
    },
