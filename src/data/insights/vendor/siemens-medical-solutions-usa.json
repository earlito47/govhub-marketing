  "narrative": {
    "intro": "Siemens Medical Solutions Usa has $234M in federal contract obligations in FY2026 to date. Siemens Medical Solutions Usa won 491 awards so far in the fiscal year, with an average award size of $477K, and obligations are up 43.6% year over year. Siemens Medical Solutions Usa draws most of its federal revenue from the Department of Veterans Affairs, which obligated $195M in FY2026 to date. Siemens Medical Solutions Usa also sells to the Department of Defense and the Department of Health and Human Services, which obligated $37M and $2.4M respectively. Siemens Medical Solutions Usa’s largest market is Irradiation Apparatus Manufacturing, which accounted for $226M of obligations in FY2026 to date. FY2026 to date totals are partial fiscal year figures and reflect obligations recorded to date rather than full-year totals.",
    "sections": [
      {
        "heading": "How concentrated are Siemens Medical Solutions Usa’s federal sales by agency?",
        "body": "The Department of Veterans Affairs is the largest buyer, obligating $195M in FY2026 to date. The Department of Defense is the second buyer, obligating $37M. The Department of Health and Human Services and the Department of the Interior follow with $2.4M and $16.8K respectively."
      },
      {
        "heading": "What products and NAICS markets drive Siemens Medical Solutions Usa’s obligations?",
        "body": "Irradiation Apparatus Manufacturing is the dominant market, accounting for $226M in FY2026 to date. Electronic and Precision Equipment Repair and Maintenance and Electromedical and Electrotherapeutic Apparatus Manufacturing follow with $6M and $448K respectively. A mix of wholesaling, surgical instrument manufacturing, and software and services markets make up the remainder of obligations."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does Siemens Medical Solutions Usa make from federal contracts?",
      "a": "Siemens Medical Solutions Usa has $234M in federal contract obligations in FY2026 to date. Siemens Medical Solutions Usa won 491 awards so far this fiscal year, with an average award size of $477K, and obligations are up 43.6% year over year. FY2026 to date totals are partial fiscal year figures."
    },
    {
      "q": "Which agencies buy from Siemens Medical Solutions Usa?",
      "a": "The Department of Veterans Affairs, the Department of Defense, and the Department of Health and Human Services buy from Siemens Medical Solutions Usa. The Department of Veterans Affairs obligated $195M, the Department of Defense obligated $37M, and the Department of Health and Human Services obligated $2.4M in FY2026 to date. The Department of the Interior also appears with $16.8K obligated."
    },
    {
      "q": "What does Siemens Medical Solutions Usa sell to the government?",
      "a": "Siemens Medical Solutions Usa sells mainly irradiation apparatus and related medical equipment and services to the government. Irradiation Apparatus Manufacturing accounted for $226M of obligations in FY2026 to date. Other markets include Electronic and Precision Equipment Repair and Maintenance at $6M, Electromedical and Electrotherapeutic Apparatus Manufacturing at $448K, and various wholesaling, surgical instrument, software, and services NAICS categories."
    },
