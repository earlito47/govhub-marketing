  "narrative": {
    "intro": "United Launch Services received $303M in federal contract obligations in FY2026 to date. United Launch Services won 31 awards so far this fiscal year, with an average award size of $9.8M. Obligations fell 51.0% year over year. Fiscal-year obligations peaked at $1.5B in FY24 and dropped to $619M in FY25 before reaching $303M in FY26. The Department of Defense is the largest buyer, obligating $237M. The National Aeronautics and Space Administration obligated $66.2M. Nonscheduled Chartered Freight Air Transportation is the largest NAICS market for United Launch Services at $237M. Guided Missile and Space Vehicle Propulsion Unit and Propulsion Unit Parts Manufacturing is the second market at $66.2M. Current-year totals are partial because FY2026 is year to date, and some figures reported as award values in contracts tables represent total contract values rather than current-year obligations.",
    "sections": [
      {
        "heading": "Who are United Launch Services top buyers this year?",
        "body": "The Department of Defense obligated $237M for United Launch Services in FY2026 to date. The National Aeronautics and Space Administration obligated $66.2M. These two agencies account for the entirety of the top buying-agency totals shown for FY2026 to date."
      },
      {
        "heading": "What markets and products is United Launch Services selling to the government?",
        "body": "Nonscheduled Chartered Freight Air Transportation is the largest market for United Launch Services at $237M. Guided Missile and Space Vehicle Propulsion Unit and Propulsion Unit Parts Manufacturing is the second market at $66.2M. These market totals align with the agency obligations to the Department of Defense and NASA."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does United Launch Services make from federal contracts?",
      "a": "United Launch Services made $303M in federal contract obligations in FY2026 to date. United Launch Services received 31 awards this fiscal year with an average award size of $9.8M, and obligations fell 51.0% year over year."
    },
    {
      "q": "Which agencies buy from United Launch Services?",
      "a": "The Department of Defense buys the most from United Launch Services. The Department of Defense obligated $237M and the National Aeronautics and Space Administration obligated $66.2M in FY2026 to date."
    },
    {
      "q": "What does United Launch Services sell to the government?",
      "a": "United Launch Services sells services in Nonscheduled Chartered Freight Air Transportation and products in Guided Missile and Space Vehicle Propulsion Unit and Propulsion Unit Parts Manufacturing. Nonscheduled Chartered Freight Air Transportation accounts for $237M and Guided Missile and Space Vehicle Propulsion Unit and Propulsion Unit Parts Manufacturing accounts for $66.2M in FY2026 to date."
    },
