  "narrative": {
    "intro": "Mitre obligated $1.2B in FY2026 to date across 394 awards, with an average award size of $3.1M. Mitre's obligations are down 8.8% year over year. Mitre's obligations by fiscal year were $1.5B in FY21, $1.5B in FY22, $1.7B in FY23, $1.7B in FY24, $1.3B in FY25, and $1.2B in FY26. The Department of Defense is the largest buyer, obligating $639M in FY2026 to date. Other top buyers include the Department of Transportation at $165M and the Department of Health and Human Services at $149M. Research and Development in the Physical, Engineering, and Life Sciences (except Nanotechnology and Biotechnology) is the largest market for Mitre, with obligations of $887M. Engineering Services accounted for $163M and All Other Professional, Scientific, and Technical Services accounted for $99.2M. This profile summarizes current-year obligations and the main buying agencies and markets that drive Mitre's federal contracting activity.",
    "sections": [
      {
        "heading": "Who are Mitre's biggest buyers this year?",
        "body": "The Department of Defense is the largest buyer, obligating $639M in FY2026 to date. The Department of Transportation obligated $165M and the Department of Health and Human Services obligated $149M. The Department of Homeland Security and the Department of Commerce obligated $97.5M and $89.3M respectively."
      },
      {
        "heading": "What work areas drive Mitre's obligations?",
        "body": "Research and Development in the Physical, Engineering, and Life Sciences (except Nanotechnology and Biotechnology) is the largest market at $887M. Engineering Services accounted for $163M and All Other Professional, Scientific, and Technical Services accounted for $99.2M. Smaller markets include Research and Development in the Social Sciences and Humanities at $36.6M and Other Management Consulting Services at $9.8M."
      }
    ]
  },
  "faq": [
    {
      "q": "How much does Mitre make from federal contracts?",
      "a": "Mitre obligated $1.2B from federal contracts in FY2026 to date. Mitre received 394 awards in the period and the average award size was $3.1M. Obligations are down 8.8% year over year."
    },
    {
      "q": "Which agencies buy from Mitre?",
      "a": "The Department of Defense is Mitre's largest buyer, obligating $639M in FY2026 to date. Other top buyers include the Department of Transportation at $165M and the Department of Health and Human Services at $149M. The Department of Homeland Security obligated $97.5M and the Department of Commerce obligated $89.3M."
    },
    {
      "q": "What does Mitre sell to the government?",
      "a": "Mitre sells research, engineering, and professional services to the government. Research and Development in the Physical, Engineering, and Life Sciences (except Nanotechnology and Biotechnology) accounted for $887M, Engineering Services accounted for $163M, and All Other Professional, Scientific, and Technical Services accounted for $99.2M."
    },
